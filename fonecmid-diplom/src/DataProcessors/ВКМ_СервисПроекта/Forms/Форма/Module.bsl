&НаСервере
Процедура ВКМ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.ВКМ_ГодДемо = Год(ТекущаяДатаСеанса());
	Объект.ВКМ_НачалоКалендаря = Дата(Объект.ВКМ_ГодДемо - 1, 1, 1);
	Объект.ВКМ_КонецКалендаря = Дата(Объект.ВКМ_ГодДемо, 12, 31);
	Объект.ВКМ_Результат = "Шаблон пятидневки не учитывает праздники и переносы. Перед расчетом уточните календарь организации. Демонстрационные команды выполняются только в отдельной копии базы";
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_Настроить(Команда)
	ВКМ_НастроитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВКМ_НастроитьНаСервере()
	ВКМ_ПроверитьАдминистратора();
	ВКМ_НачальнаяНастройка.ВКМ_СоздатьВидыРасчета();
	Объект.ВКМ_Результат = "Виды расчета и их зависимости настроены. Профили БСП обновляются стандартной процедурой обновления программы";
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_Календарь(Команда)
	ВКМ_ЗаполнитьКалендарьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВКМ_ЗаполнитьКалендарьНаСервере()
	Если Не РольДоступна("ПолныеПрава") И Не РольДоступна("ВКМ_КадровикРасчетчик") Тогда
		ВызватьИсключение "Недостаточно прав для настройки календаря";
	КонецЕсли;
	ВКМ_НачальнаяНастройка.ВКМ_ЗаполнитьПятидневку(Объект.ВКМ_НачалоКалендаря, Объект.ВКМ_КонецКалендаря);
	Объект.ВКМ_Результат = "Добавлены отсутствующие даты пятидневки. Существующие даты сохранены. Проверьте праздники и переносы в календаре";
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_Демо(Команда)
	Операция = ВКМ_НачатьДемоНаСервере();
	Оповещение = Новый ОписаниеОповещения("ВКМ_ДемоЗавершено", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект));
КонецПроцедуры

&НаСервере
Функция ВКМ_НачатьДемоНаСервере()
	ВКМ_ПроверитьАдминистратора();
	Если Не Объект.ВКМ_ЭтоДемоБаза Тогда
		ВызватьИсключение "Подтвердите, что открыта демонстрационная копия базы";
	КонецЕсли;
	Параметры = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(Параметры,
		"ВКМ_ДемонстрационныеДанные.ВКМ_СоздатьДемонстрационныеДанные", Объект.ВКМ_ГодДемо, Объект.ВКМ_ЭтоДемоБаза);
КонецФункции

&НаКлиенте
Процедура ВКМ_ДемоЗавершено(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		Сообщить(Результат.КраткоеПредставлениеОшибки);
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		ВКМ_ПринятьРезультат(Результат.АдресРезультата);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВКМ_ПринятьРезультат(Знач Адрес)
	Объект.ВКМ_Результат = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_Пользователи(Команда)
	ВКМ_СоздатьПользователейНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВКМ_СоздатьПользователейНаСервере()
	ВКМ_ПроверитьАдминистратора();
	ВКМ_ДемонстрационныеДанные.ВКМ_СоздатьТестовыхПользователей(Объект.ВКМ_ГодДемо, Объект.ВКМ_ЭтоДемоБаза);
	Объект.ВКМ_Результат = "Тестовые пользователи и группы поставляемых профилей созданы. Существующие пароли не изменялись";
КонецПроцедуры

&НаСервере
Процедура ВКМ_ПроверитьАдминистратора()
	Если Не РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "Операция доступна только администратору";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_Пересчитать(Команда)
	ВКМ_ПересчитатьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВКМ_ПересчитатьНаСервере()
	Если Не РольДоступна("ПолныеПрава") И Не РольДоступна("ВКМ_КадровикРасчетчик") Тогда
		ВызватьИсключение "Недостаточно прав для пересчета зарплаты";
	КонецЕсли;
	Количество = ВКМ_РасчетЗарплаты.ВКМ_ПересчитатьНачисления(Объект.ВКМ_НачалоКалендаря);
	Объект.ВКМ_Результат = "Пересчитано документов: " + Строка(Количество);
КонецПроцедуры
