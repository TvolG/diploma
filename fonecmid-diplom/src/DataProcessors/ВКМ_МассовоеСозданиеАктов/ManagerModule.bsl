// Единая точка создания: форма и внешние вызовы используют одинаковые проверки.
Функция СоздатьДокументыДляАбонентскихДоговоров(Знач Период, Знач Организация = Неопределено, ДоговорыКСозданию = Неопределено) Экспорт
	Обработка = Обработки.ВКМ_МассовоеСозданиеАктов.Создать();
	Обработка.Период = Период;
	Обработка.ЗаполнитьДоговоры();
	Результат = Новый Массив;
	Для Каждого СтрокаДоговора Из Обработка.Договоры Цикл
		Если Организация <> Неопределено И СтрокаДоговора.Организация <> Организация Тогда
			Продолжить;
		КонецЕсли;
		Если ДоговорыКСозданию <> Неопределено И ДоговорыКСозданию.Найти(СтрокаДоговора.Договор) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Данные = Новый Структура("Договор,Контрагент,Организация,ДокументРеализация,Создан,Ошибка",
			СтрокаДоговора.Договор, СтрокаДоговора.Контрагент, СтрокаДоговора.Организация, Неопределено, Ложь, "");
		НачатьТранзакцию();
		Попытка
			// Сериализуем проверку и создание по договору между сеансами обработки.
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.ДоговорыКонтрагентов");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СтрокаДоговора.Договор);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.РеализацияТоваровУслуг
			|ГДЕ Договор = &Договор И Дата МЕЖДУ &Начало И &Конец И НЕ ПометкаУдаления");
			Запрос.УстановитьПараметр("Договор", СтрокаДоговора.Договор);
			Запрос.УстановитьПараметр("Начало", НачалоМесяца(Период));
			Запрос.УстановитьПараметр("Конец", КонецМесяца(Период));
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Данные.ДокументРеализация = Выборка.Ссылка;
				Данные.Создан = Истина;
			Иначе
				Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
				Документ.Дата = КонецМесяца(Период);
				Документ.Заполнить(Неопределено);
				Документ.Организация = СтрокаДоговора.Организация;
				Документ.Контрагент = СтрокаДоговора.Контрагент;
				Документ.Договор = СтрокаДоговора.Договор;
				Документ.Комментарий = "Создан автоматически";
				Документ.ВыполнитьАвтозаполнение();
				Если Документ.Услуги.Количество() = 0 Тогда
					ВызватьИсключение "Не заполнена табличная часть Услуги";
				КонецЕсли;
				Документ.Записать(РежимЗаписиДокумента.Проведение);
				Данные.ДокументРеализация = Документ.Ссылка;
				Данные.Создан = Истина;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			Данные.Ошибка = ОписаниеОшибки();
		КонецПопытки;
		Результат.Добавить(Данные);
	КонецЦикла;
	Возврат Результат;
КонецФункции
