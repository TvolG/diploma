&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Период) = Ложь Тогда
		ТекДата = ТекущаяДата();
		Объект.Период = НачалоМесяца(ДобавитьМесяц(ТекДата, -1));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте               
Процедура ЗаполнитьДоговоры(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Сообщить("Укажите период для формирования актов");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДоговорыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоговорыНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ЗаполнитьДоговоры();
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьАкты(Команда)
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Сообщить("Укажите период для формирования актов");
		Возврат;
	КонецЕсли;
	ЗаполнитьДоговорыНаСервере();
	Если Объект.Договоры.Количество() = 0 Тогда
		Сообщить("За выбранный период нет действующих абонентских договоров");
		Возврат;
	КонецЕсли;
	
	ЕстьНеСозданные = Ложь;
	Для Каждого СтрокаДоговор Из Объект.Договоры Цикл
		Если Не СтрокаДоговор.Создан Тогда
			ЕстьНеСозданные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьНеСозданные Тогда
		Сообщить("Все акты уже созданы");
		Возврат;
	КонецЕсли;
	
	Элементы.Договоры.Доступность = Ложь;
	Элементы.Период.Доступность = Ложь;
	Попытка
		Операция = ВКМ_НачатьСозданиеАктов();
	Исключение
		Элементы.Договоры.Доступность = Истина;
		Элементы.Период.Доступность = Истина;
		ВызватьИсключение;
	КонецПопытки;
	Оповещение = Новый ОписаниеОповещения("ВКМ_СозданиеАктовЗавершено", ЭтотОбъект);
	Ожидание = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, Ожидание);
	
КонецПроцедуры

&НаСервере
Функция ВКМ_НачатьСозданиеАктов()
	СписокДоговоров = Новый Массив;
	Для Каждого СтрокаДоговора Из Объект.Договоры Цикл
		СписокДоговоров.Добавить(СтрокаДоговора.Договор);
	КонецЦикла;
	Параметры = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Параметры.НаименованиеФоновогоЗадания = "Создание актов за месяц";
	Возврат ДлительныеОперации.ВыполнитьФункцию(Параметры,
		"Обработка.ВКМ_МассовоеСозданиеАктов.МодульОбъекта.ВКМ_СоздатьАктыВФоне", Объект.Период, СписокДоговоров);
КонецФункции

&НаКлиенте
Процедура ВКМ_СозданиеАктовЗавершено(РезультатОперации, ДополнительныеПараметры) Экспорт
	Элементы.Договоры.Доступность = Истина;
	Элементы.Период.Доступность = Истина;
	Если РезультатОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если РезультатОперации.Статус = "Ошибка" Тогда
		Сообщить(РезультатОперации.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	Если РезультатОперации.Статус = "Выполнено" Тогда
		ВКМ_ПолучитьРезультатСоздания(РезультатОперации.АдресРезультата);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВКМ_ПолучитьРезультатСоздания(Знач АдресРезультата)
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Объект.Договоры.Очистить();
	
	Для Каждого ЭлементМассива Из Результат Цикл
		НоваяСтрока = Объект.Договоры.Добавить();
		НоваяСтрока.Договор = ЭлементМассива.Договор;
		НоваяСтрока.Контрагент = ЭлементМассива.Контрагент;
		НоваяСтрока.Организация = ЭлементМассива.Организация;
		НоваяСтрока.ДокументРеализации = ЭлементМассива.ДокументРеализация;
		НоваяСтрока.Создан = ЭлементМассива.Создан;
		Если Не ПустаяСтрока(ЭлементМассива.Ошибка) Тогда
			Сообщить(СтрШаблон("Договор %1: %2", ЭлементМассива.Договор, ЭлементМассива.Ошибка));
		КонецЕсли;
	КонецЦикла;
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
КонецПроцедуры
