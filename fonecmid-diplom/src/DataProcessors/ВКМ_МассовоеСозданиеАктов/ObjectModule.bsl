Процедура ЗаполнитьДоговоры() Экспорт
	
	Если ЗначениеЗаполнено(Период) = Ложь Тогда
		ВызватьИсключение "Укажите период для формирования актов";
	КонецЕсли;
	
	НачПериода = НачалоМесяца(Период);
	КонПериода = КонецМесяца(Период);
	
	Договоры.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.Владелец КАК Контрагент,
	|	Договоры.Организация КАК Организация,
	|	Реализации.Ссылка КАК ДокументРеализации
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	| ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
	| ПО Договоры.Ссылка = Реализации.Договор
	| И Реализации.Дата МЕЖДУ &НачПериода И &КонПериода
	| И НЕ Реализации.ПометкаУдаления
	|ГДЕ
	|	Договоры.ВидДоговора = &ВидДоговора
	|	И НЕ Договоры.ПометкаУдаления
	| И Договоры.ВКМ_АбонДатаНачала <= &КонПериода
	| И Договоры.ВКМ_АбонДатаОкончания >= &НачПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Договоры.Владелец,
	|	Договоры.Ссылка";
	
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание);
	Запрос.УстановитьПараметр("НачПериода", НачПериода);
	Запрос.УстановитьПараметр("КонПериода", КонПериода);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ДобавленныеДоговоры = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ДобавленныеДоговоры.Найти(Выборка.Договор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеДоговоры.Добавить(Выборка.Договор);
		
		СтрокаДоговор = Договоры.Добавить();
		СтрокаДоговор.Договор = Выборка.Договор;
		СтрокаДоговор.Организация = Выборка.Организация;
		СтрокаДоговор.Контрагент = Выборка.Контрагент;
		СтрокаДоговор.Создан = ЗначениеЗаполнено(Выборка.ДокументРеализации);
		Если СтрокаДоговор.Создан Тогда
			СтрокаДоговор.ДокументРеализации = Выборка.ДокументРеализации;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


// ВКМ_Начало: точка входа длительной операции БСП.
Функция ВКМ_СоздатьАктыВФоне(Знач МесяцАктов, Знач СписокДоговоров) Экспорт
	Возврат Обработки.ВКМ_МассовоеСозданиеАктов.СоздатьДокументыДляАбонентскихДоговоров(
		МесяцАктов, Неопределено, СписокДоговоров);
КонецФункции
// ВКМ_Конец.
