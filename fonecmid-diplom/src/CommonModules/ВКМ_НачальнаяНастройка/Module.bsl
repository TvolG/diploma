Процедура ВКМ_СоздатьВидыРасчета() Экспорт
	Оклад = ВКМ_ОбеспечитьВид(ПланыВидовРасчета.ВКМ_ОсновныеНачисления, "ЗП", "Оклад");
	Процент = ВКМ_ОбеспечитьВид(ПланыВидовРасчета.ВКМ_ОсновныеНачисления, "ПРОЦ", "Процент за выполненные работы");
	Отпуск = ВКМ_ОбеспечитьВид(ПланыВидовРасчета.ВКМ_ОсновныеНачисления, "ОТП", "Отпуск");
	Премия = ВКМ_ОбеспечитьВид(ПланыВидовРасчета.ВКМ_ДополнительныеНачисления, "ПРЕМ", "Фиксированная премия");
	ВКМ_ОбеспечитьВид(ПланыВидовРасчета.ВКМ_Удержания, "НЛГ", "НДФЛ 13%");
	ОбъектОклада = Оклад.ПолучитьОбъект();
	ВКМ_ДобавитьСвязь(ОбъектОклада.ВытесняющиеВидыРасчета, Отпуск);
	ОбъектОклада.Записать();
	ОбъектОтпуска = Отпуск.ПолучитьОбъект();
	ВКМ_ДобавитьСвязь(ОбъектОтпуска.БазовыеВидыРасчета, Оклад);
	ВКМ_ДобавитьСвязь(ОбъектОтпуска.БазовыеВидыРасчета, Процент);
	ВКМ_ДобавитьСвязь(ОбъектОтпуска.БазовыеВидыРасчета, Премия);
	ВКМ_ДобавитьСвязь(ОбъектОтпуска.ВедущиеВидыРасчета, Оклад);
	ВКМ_ДобавитьСвязь(ОбъектОтпуска.ВедущиеВидыРасчета, Процент);
	ВКМ_ДобавитьСвязь(ОбъектОтпуска.ВедущиеВидыРасчета, Премия);
	ОбъектОтпуска.Записать();
КонецПроцедуры

Функция ВКМ_ОбеспечитьВид(МенеджерПлана, Знач Код, Знач Наименование)
	Ссылка = МенеджерПлана.НайтиПоКоду(Код);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Объект = МенеджерПлана.СоздатьВидРасчета();
		Объект.Код = Код;
		Объект.Наименование = Наименование;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Процедура ВКМ_ДобавитьСвязь(ТаблицаСвязей, ВидРасчета)
	Для Каждого Связь Из ТаблицаСвязей Цикл
		Если Связь.ВидРасчета = ВидРасчета Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ТаблицаСвязей.Добавить().ВидРасчета = ВидРасчета;
КонецПроцедуры

Процедура ВКМ_ЗаполнитьПятидневку(Знач Начало, Знач Конец) Экспорт
	Если Не РольДоступна("ПолныеПрава") И Не РольДоступна("ВКМ_ОтделКадров") И Не РольДоступна("ВКМ_КадровикРасчетчик") Тогда
		ВызватьИсключение "Недостаточно прав для заполнения календаря";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Начало) Или Конец < Начало Тогда
		ВызватьИсключение "Укажите корректный период календаря";
	КонецЕсли;
	День = НачалоДня(Начало);
	Пока День <= НачалоДня(Конец) Цикл
		Набор = РегистрыСведений.ВКМ_КалендарьРаботы.СоздатьНаборЗаписей();
		Набор.Отбор.ВКМ_Дата.Установить(День);
		Набор.Прочитать();
		Если Набор.Количество() = 0 Тогда
			Запись = Набор.Добавить();
			Запись.ВКМ_Дата = День;
			Запись.ВКМ_РабочийДень = ?(ДеньНедели(День) <= 5, 1, 0);
			Запись.ВКМ_КалендарныйДень = 1;
			Набор.Записать();
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;
КонецПроцедуры
