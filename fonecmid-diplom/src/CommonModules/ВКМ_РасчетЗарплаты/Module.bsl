#Область ПрограммныйИнтерфейс

Функция ВКМ_ВидыРасчета() Экспорт
	Виды = Новый Структура;
	Виды.Вставить("Оклад", ПланыВидовРасчета.ВКМ_ОсновныеНачисления.НайтиПоКоду("ЗП"));
	Виды.Вставить("Процент", ПланыВидовРасчета.ВКМ_ОсновныеНачисления.НайтиПоКоду("ПРОЦ"));
	Виды.Вставить("Отпуск", ПланыВидовРасчета.ВКМ_ОсновныеНачисления.НайтиПоКоду("ОТП"));
	Виды.Вставить("Премия", ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.НайтиПоКоду("ПРЕМ"));
	Виды.Вставить("НДФЛ", ПланыВидовРасчета.ВКМ_Удержания.НайтиПоКоду("НЛГ"));
	Для Каждого Вид Из Виды Цикл
		Если Не ЗначениеЗаполнено(Вид.Значение) Тогда
			ВызватьИсключение "Не выполнена начальная настройка видов расчета: " + Вид.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Виды;
КонецФункции

Функция ВКМ_УсловияОплаты(Знач Сотрудник, Знач ДатаУсловий) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Условия.Оклад КАК Оклад, Условия.ПроцентОтРабот КАК Процент
	|ИЗ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Дата, Сотрудник = &Сотрудник) КАК Условия");
	Запрос.УстановитьПараметр("Дата", НачалоМесяца(ДатаУсловий));
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("Для сотрудника %1 не установлены условия оплаты на %2", Сотрудник, ДатаУсловий);
	КонецЕсли;
	Возврат Новый Структура("Оклад,Процент", Выборка.Оклад, Выборка.Процент);
КонецФункции

Функция ВКМ_ПроверитьКалендарь(Знач Начало, Знач Конец) Экспорт
	Начало = НачалоДня(Начало);
	Конец = КонецДня(Конец);
	Запрос = Новый Запрос(
	"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Дней, СУММА(Календарь.ВКМ_РабочийДень) КАК РабочихДней
	|ИЗ РегистрСведений.ВКМ_КалендарьРаботы КАК Календарь
	|ГДЕ Календарь.ВКМ_Дата МЕЖДУ &Начало И &Конец");
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.Дней <> (НачалоДня(Конец) - Начало) / 86400 + 1 Тогда
		ВызватьИсключение СтрШаблон("Заполните календарь работы за каждый день с %1 по %2, включая выходные", Начало, Конец);
	КонецЕсли;
	Возврат Выборка.РабочихДней;
КонецФункции

Функция ВКМ_ВознаграждениеЗаРаботы(Знач Сотрудник, Знач Начало, Знач Конец) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(Работы.ВКМ_СуммаКОплатеОборот), 0) КАК Сумма
	|ИЗ РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(&Начало, &Конец, , ВКМ_Сотрудник = &Сотрудник) КАК Работы");
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;
КонецФункции

Процедура ВКМ_ЗаблокироватьСотрудников(ТаблицаСотрудников) Экспорт
	Сотрудники = ТаблицаСотрудников.Выгрузить().ВыгрузитьКолонку("Сотрудник");
	ДанныеБлокировки = Новый ТаблицаЗначений;
	ДанныеБлокировки.Колонки.Добавить("Сотрудник");
	Для Каждого Сотрудник Из Сотрудники Цикл
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			ВызватьИсключение "Укажите сотрудника в каждой строке";
		КонецЕсли;
		ДанныеБлокировки.Добавить().Сотрудник = Сотрудник;
	КонецЦикла;
	ДанныеБлокировки.Сортировать("Сотрудник");
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.Пользователи");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = ДанныеБлокировки;
	Элемент.ИспользоватьИзИсточникаДанных("Ссылка", "Сотрудник");
	Блокировка.Заблокировать();
КонецПроцедуры

Процедура ВКМ_ПроверитьСтроки(Документ, Виды) Экспорт
	Если Не ЗначениеЗаполнено(Документ.Период) Или Документ.Начисления.Количество() = 0 Тогда
		ВызватьИсключение "Укажите месяц и добавьте строки начислений";
	КонецЕсли;
	Для Каждого Строка Из Документ.Начисления Цикл
		Если Строка.ВКМ_ВидНачисления <> Виды.Оклад И Строка.ВКМ_ВидНачисления <> Виды.Процент И Строка.ВКМ_ВидНачисления <> Виды.Отпуск Тогда
			ВызватьИсключение "Выберите вид начисления: оклад, процент за работы или отпуск";
		КонецЕсли;    
		
		Если Строка.ВКМ_ВидНачисления = Виды.Отпуск	И (Не ЗначениеЗаполнено(Строка.ВКМ_ДатаНачала)	Или Не ЗначениеЗаполнено(Строка.ВКМ_ДатаОкончания))
			Тогда
				ВызватьИсключение "Укажите фактические даты начала и окончания отпуска";
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Строка.ВКМ_ДатаНачала) Тогда
			Строка.ВКМ_ДатаНачала = НачалоМесяца(Документ.Период);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.ВКМ_ДатаОкончания) Тогда
			Строка.ВКМ_ДатаОкончания = НачалоДня(КонецМесяца(Документ.Период));
		КонецЕсли;
		Строка.ВКМ_ДатаНачала = НачалоДня(Строка.ВКМ_ДатаНачала);
		Строка.ВКМ_ДатаОкончания = НачалоДня(Строка.ВКМ_ДатаОкончания);
		Если Строка.ВКМ_ДатаОкончания < Строка.ВКМ_ДатаНачала
			Или НачалоМесяца(Строка.ВКМ_ДатаНачала) <> НачалоМесяца(Документ.Период)
			Или НачалоМесяца(Строка.ВКМ_ДатаОкончания) <> НачалоМесяца(Документ.Период) Тогда
			ВызватьИсключение "Период строки должен находиться внутри месяца начисления; переходящий отпуск разделите по месяцам";
		КонецЕсли;
		Если Строка.ВКМ_ВидНачисления = Виды.Процент Тогда
			Если Не ЗначениеЗаполнено(Строка.ВКМ_ДатаРаботНачало) Тогда
				Строка.ВКМ_ДатаРаботНачало = Строка.ВКМ_ДатаНачала;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.ВКМ_ДатаРаботКонец) Тогда
				Строка.ВКМ_ДатаРаботКонец = Строка.ВКМ_ДатаОкончания;
			КонецЕсли;
			Если Строка.ВКМ_ДатаРаботКонец < Строка.ВКМ_ДатаРаботНачало Тогда
				ВызватьИсключение "Окончание периода работ должно быть не раньше начала";
			КонецЕсли;
		КонецЕсли;
		Для Каждого Другая Из Документ.Начисления Цикл
			Если Другая.НомерСтроки >= Строка.НомерСтроки Тогда
				Прервать;
			КонецЕсли;
			Если Другая.Сотрудник = Строка.Сотрудник И Другая.ВКМ_ВидНачисления = Строка.ВКМ_ВидНачисления
				И Другая.ВКМ_ДатаНачала <= Строка.ВКМ_ДатаОкончания И Другая.ВКМ_ДатаОкончания >= Строка.ВКМ_ДатаНачала Тогда
				ВызватьИсключение "Пересекаются периоды начисления одного вида одному сотруднику";
			КонецЕсли;
			Если Другая.Сотрудник = Строка.Сотрудник И Строка.ВКМ_ВидНачисления = Виды.Процент И Другая.ВКМ_ВидНачисления = Виды.Процент
				И Другая.ВКМ_ДатаРаботНачало <= Строка.ВКМ_ДатаРаботКонец И Другая.ВКМ_ДатаРаботКонец >= Строка.ВКМ_ДатаРаботНачало Тогда
				ВызватьИсключение "Периоды оплачиваемых работ одного сотрудника не должны пересекаться";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ВКМ_ДанныеГрафика(Знач Регистратор) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Данные.НомерСтроки КАК НомерСтроки,
	| ЕСТЬNULL(Данные.ВКМ_РабочийДеньФактическийПериодДействия, 0) КАК Факт,
	| ЕСТЬNULL(Данные.ВКМ_РабочийДеньБазовыйПериод, 0) КАК РабочихДнейБазы
	|ИЗ РегистрРасчета.ВКМ_ОсновныеНачисления.ДанныеГрафика(Регистратор = &Регистратор) КАК Данные");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ВКМ_БазаОтпуска(Знач Регистратор) Экспорт
	Измерения = Новый Массив;
	Измерения.Добавить("Сотрудник");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Измерения", Измерения);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.Текст = "ВЫБРАТЬ РасчетнаяБаза.НомерСтроки КАК НомерСтроки, РасчетнаяБаза.СуммаБаза КАК СуммаБазы
	|ИЗ РегистрРасчета.ВКМ_ОсновныеНачисления.БазаВКМ_ОсновныеНачисления(&Измерения, &Измерения, , Регистратор = &Регистратор) КАК РасчетнаяБаза";
	Таблица = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ РасчетнаяБаза.НомерСтроки КАК НомерСтроки, РасчетнаяБаза.СуммаБаза КАК СуммаБазы
	|ИЗ РегистрРасчета.ВКМ_ОсновныеНачисления.БазаВКМ_ДополнительныеНачисления(&Измерения, &Измерения, , Регистратор = &Регистратор) КАК РасчетнаяБаза";
	Премии = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаПремии Из Премии Цикл
		Строка = Таблица.Добавить();
		Строка.НомерСтроки = СтрокаПремии.НомерСтроки;
		Строка.СуммаБазы = СтрокаПремии.СуммаБазы;
	КонецЦикла;
	Таблица.Свернуть("НомерСтроки", "СуммаБазы");
	Возврат Таблица;
КонецФункции

Функция ВКМ_РанееНачисленныеОтпускные(Знач Сотрудник, Знач Начало, Знач Конец, Знач ВидОтпуск) Экспорт
	// Предыдущие отпускные входят в "начисленную сумму" по формуле ТЗ.
	// Ссылка вида на самого себя не добавляется в граф зависимостей ПВР.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(Начисления.Сумма), 0) КАК Сумма
	|ИЗ РегистрРасчета.ВКМ_ОсновныеНачисления КАК Начисления
	|ГДЕ Начисления.Активность И Начисления.Сотрудник = &Сотрудник И Начисления.ВидРасчета = &Вид
	| И Начисления.ПериодРегистрации МЕЖДУ &Начало И &Конец");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Вид", ВидОтпуск);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;
КонецФункции

Процедура ВКМ_ПроверитьЧужиеНачисления(Документ) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Начисления.Регистратор КАК Регистратор
	|ИЗ РегистрРасчета.ВКМ_ОсновныеНачисления КАК Начисления
	|ГДЕ Начисления.Активность И Начисления.Регистратор <> &Регистратор
	| И Начисления.Сотрудник В (&Сотрудники)
	| И Начисления.ПериодРегистрации = &Месяц");
	Запрос.УстановитьПараметр("Регистратор", Документ.Ссылка);
	Запрос.УстановитьПараметр("Сотрудники", Документ.Начисления.Выгрузить().ВыгрузитьКолонку("Сотрудник"));
	Запрос.УстановитьПараметр("Месяц", НачалоМесяца(Документ.Дата));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("Сотрудник уже начислен за этот месяц документом %1. Измените его строки, чтобы оклад и отпуск пересчитывались совместно", Выборка.Регистратор);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

Процедура ВКМ_ПодготовитьСуммыДоЗаписи(Документ) Экспорт
	Если НачалоМесяца(Документ.Дата) <> НачалоМесяца(Документ.Период) Тогда
		ВызватьИсключение "Дата документа должна находиться в месяце начисления";
	КонецЕсли;
	Виды = ВКМ_ВидыРасчета();
	ВКМ_ПроверитьСтроки(Документ, Виды);
	ВКМ_ЗаблокироватьСотрудников(Документ.Начисления);
	ВКМ_ПроверитьЧужиеНачисления(Документ);
	Норма = ВКМ_ПроверитьКалендарь(НачалоМесяца(Документ.Период), КонецМесяца(Документ.Период));
	Если Норма <= 0 Тогда
		ВызватьИсключение "В месяце нет рабочих дней по календарю";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ВКМ_Дата КАК Дата, ВКМ_РабочийДень КАК РабочийДень
	|ИЗ РегистрСведений.ВКМ_КалендарьРаботы ГДЕ ВКМ_Дата МЕЖДУ &Начало И &Конец");
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Документ.Период));
	Запрос.УстановитьПараметр("Конец", КонецМесяца(Документ.Период));
	Календарь = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Документ.Начисления Цикл
		Строка.Оклад = 0;
		Строка.ПроцентОтРабот = 0;
		Строка.ВКМ_СуммаОтпускных = 0;
		Строка.ВКМ_НормаДней = 0;
		Строка.ВКМ_ФактДней = 0;
		Строка.КоличествоДнейОтпуска = 0;
		Если Строка.ВКМ_ВидНачисления = Виды.Оклад Тогда
			Условия = ВКМ_УсловияОплаты(Строка.Сотрудник, Строка.ВКМ_ДатаНачала);
			Факт = 0;
			День = Строка.ВКМ_ДатаНачала;
			Пока День <= Строка.ВКМ_ДатаОкончания Цикл
				ВОтпуске = Ложь;
				Для Каждого Отпуск Из Документ.Начисления Цикл
					Если Отпуск.Сотрудник = Строка.Сотрудник И Отпуск.ВКМ_ВидНачисления = Виды.Отпуск
						И Отпуск.ВКМ_ДатаНачала <= День И Отпуск.ВКМ_ДатаОкончания >= День Тогда
						ВОтпуске = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не ВОтпуске Тогда
					Факт = Факт + Календарь.Найти(День, "Дата").РабочийДень;
				КонецЕсли;
				День = День + 86400;
			КонецЦикла;
			Строка.ВКМ_НормаДней = Норма;
			Строка.ВКМ_ФактДней = Факт;
			Строка.Оклад = Окр(Условия.Оклад * Факт / Норма, 2);
		ИначеЕсли Строка.ВКМ_ВидНачисления = Виды.Процент Тогда
			Строка.ПроцентОтРабот = Окр(ВКМ_ВознаграждениеЗаРаботы(Строка.Сотрудник,
				Строка.ВКМ_ДатаРаботНачало, Строка.ВКМ_ДатаРаботКонец), 2);
		ИначеЕсли Строка.ВКМ_ВидНачисления = Виды.Отпуск Тогда
			НачалоБазы = ДобавитьМесяц(НачалоМесяца(Строка.ВКМ_ДатаНачала), -12);
			КонецБазы = КонецМесяца(ДобавитьМесяц(Строка.ВКМ_ДатаНачала, -1));
			ДнейБазы = ВКМ_ПроверитьКалендарь(НачалоБазы, КонецБазы);
			Если ДнейБазы <= 0 Тогда
				ВызватьИсключение "В базе отпускных нет рабочих дней";
			КонецЕсли;
			СуммаБазы = ВКМ_СуммаИсторическихНачислений(Строка.Сотрудник, НачалоБазы, КонецБазы);
			Строка.КоличествоДнейОтпуска = (Строка.ВКМ_ДатаОкончания - Строка.ВКМ_ДатаНачала) / 86400 + 1;
			Строка.ВКМ_СуммаОтпускных = Окр(СуммаБазы / ДнейБазы * Строка.КоличествоДнейОтпуска, 2);
		КонецЕсли;
		Строка.Итого = Строка.Оклад + Строка.ПроцентОтРабот + Строка.ВКМ_СуммаОтпускных;
	КонецЦикла;
	ВКМ_РаспределитьНалог(Документ.Начисления, "Итого", "НДФЛ", "КВыплате");
КонецПроцедуры

Функция ВКМ_СуммаИсторическихНачислений(Знач Сотрудник, Знач Начало, Знач Конец)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(Начисления.Сумма), 0) КАК Сумма ИЗ (
	| ВЫБРАТЬ Основные.Сумма КАК Сумма
	| ИЗ РегистрРасчета.ВКМ_ОсновныеНачисления КАК Основные
	| ГДЕ Основные.Активность И Основные.Сотрудник = &Сотрудник И Основные.ПериодРегистрации МЕЖДУ &Начало И &Конец
	| ОБЪЕДИНИТЬ ВСЕ
	| ВЫБРАТЬ Премии.Сумма
	| ИЗ РегистрРасчета.ВКМ_ДополнительныеНачисления КАК Премии
	| ГДЕ Премии.Активность И Премии.Сотрудник = &Сотрудник И Премии.ПериодРегистрации МЕЖДУ &Начало И &Конец
	|) КАК Начисления");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;
КонецФункции

Процедура ВКМ_РаспределитьНалог(Строки, Знач ПолеСуммы, Знач ПолеНалога, Знач ПолеВыплаты) Экспорт
	Итоги = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Итог = Итоги.Получить(Строка.Сотрудник);
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("Сумма,Налог,Последняя", 0, 0, Строка);
			Итоги.Вставить(Строка.Сотрудник, Итог);
		КонецЕсли;
		Строка[ПолеНалога] = Окр(Строка[ПолеСуммы] * 0.13, 2);
		Строка[ПолеВыплаты] = Строка[ПолеСуммы] - Строка[ПолеНалога];
		Итог.Сумма = Итог.Сумма + Строка[ПолеСуммы];
		Итог.Налог = Итог.Налог + Строка[ПолеНалога];
		Итог.Последняя = Строка;
	КонецЦикла;
	Для Каждого Элемент Из Итоги Цикл
		Итог = Элемент.Значение;
		Поправка = Окр(Итог.Сумма * 0.13, 2) - Итог.Налог;
		Итог.Последняя[ПолеНалога] = Итог.Последняя[ПолеНалога] + Поправка;
		Итог.Последняя[ПолеВыплаты] = Итог.Последняя[ПолеСуммы] - Итог.Последняя[ПолеНалога];
	КонецЦикла;
КонецПроцедуры

Функция ВКМ_ПересчитатьНачисления(Знач Начало) Экспорт
	Если Не ЗначениеЗаполнено(Начало) Тогда
		ВызватьИсключение "Укажите начало периода пересчета";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Начисления.Регистратор КАК Документ,
	| Начисления.ПериодРегистрации КАК Месяц
	|ИЗ РегистрРасчета.ВКМ_ОсновныеНачисления КАК Начисления
	|ГДЕ Начисления.Активность И Начисления.ПериодРегистрации >= &Начало
	|УПОРЯДОЧИТЬ ПО Месяц, Документ");
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Начало));
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = 0;
	НачатьТранзакцию();
	Попытка
		Пока Выборка.Следующий() Цикл
			Документ = Выборка.Документ.ПолучитьОбъект();
			Если Документ.Проведен И Не Документ.ПометкаУдаления Тогда
				Документ.Записать(РежимЗаписиДокумента.Проведение);
				Количество = Количество + 1;
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Количество;
КонецФункции
