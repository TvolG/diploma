// Данные создаются только по явной команде в копии базы. Ни один существующий
// хозяйственный документ не удаляется и не перепроводится этим генератором.
Функция ВКМ_СоздатьДемонстрационныеДанные(Знач ГодДемо, Знач ПодтвержденаДемонстрационнаяБаза) Экспорт
	Если Не ПодтвержденаДемонстрационнаяБаза Или Не РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "Создание демоданных разрешено администратору только в демонстрационной базе";
	КонецЕсли;
	Если ГодДемо < 2001 Или ГодДемо > 9998 Или ГодДемо <> Цел(ГодДемо) Тогда
		ВызватьИсключение "Укажите год демонстрации от 2001 до 9998";
	КонецЕсли;
	Префикс = "ДЕМО ВКМ " + Формат(ГодДемо, "ЧГ=0") + " ";
	Если ЗначениеЗаполнено(Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(Префикс + "Договор 01", Истина)) Тогда
		Возврат "Демонстрационные данные этого года уже созданы. Для повторного автотеста восстановите чистую копию базы";
	КонецЕсли;
	ВКМ_НачальнаяНастройка.ВКМ_СоздатьВидыРасчета();
	Виды = ВКМ_РасчетЗарплаты.ВКМ_ВидыРасчета();
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.ВКМ_СостояниеДемоДанных");
		Элемент.УстановитьЗначение("ВКМ_Год", ГодДемо);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Состояние = РегистрыСведений.ВКМ_СостояниеДемоДанных.СоздатьНаборЗаписей();
		Состояние.Отбор.ВКМ_Год.Установить(ГодДемо);
		Состояние.Прочитать();
		Если Состояние.Количество() > 0 И Состояние[0].ВКМ_Готово Тогда
			Результат = "Демонстрационные данные выбранного года уже созданы";
		Иначе
			ВКМ_НачальнаяНастройка.ВКМ_ЗаполнитьПятидневку(Дата(ГодДемо - 1, 1, 1), Дата(ГодДемо, 12, 31));
			Организации = Новый Массив;
			Клиенты = Новый Массив;
			Для Номер = 1 По 5 Цикл
				Организации.Добавить(ВКМ_Элемент(Справочники.Организации, Префикс + "Организация " + Строка(Номер)));
				Клиенты.Добавить(ВКМ_Элемент(Справочники.Контрагенты, Префикс + "Клиент " + Строка(Номер)));
			КонецЦикла;
			Сотрудники = Новый Массив;
			Для Номер = 1 По 15 Цикл
				Имя = Префикс + ?(Номер <= 10, "Специалист ", "Администрация ") + ВКМ_Номер(Номер);
				Сотрудник = ВКМ_Элемент(Справочники.Пользователи, Имя);
				Сотрудники.Добавить(Сотрудник);
				Условия = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СоздатьНаборЗаписей();
				Условия.Отбор.Сотрудник.Установить(Сотрудник);
				Условия.Прочитать();
				Запись = Условия.Добавить();
				Запись.Период = Дата(ГодДемо - 1, 1, 1);
				Запись.Сотрудник = Сотрудник;
				Запись.Оклад = 30000 + Номер * 1000;
				Запись.ПроцентОтРабот = ?(Номер <= 10, 10, 0);
				Условия.Записать();
			КонецЦикла;
			Для Номер = 1 По 5 Цикл
				Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();
				Номенклатура.Наименование = Префикс + ?(Номер = 1, "Абонентская плата", ?(Номер = 2, "Работы специалиста", "Услуга " + Строка(Номер)));
				Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Услуга;
				Номенклатура.НоменклатурнаяГруппа = ВКМ_Элемент(Справочники.НоменклатурныеГруппы, Префикс + "Группа " + Строка(Номер));
				Номенклатура.ЕдиницаИзмерения = ВКМ_Элемент(Справочники.ЕдиницыИзмерения, Префикс + "Ед " + Строка(Номер));
				Номенклатура.Записать();
				Если Номер = 1 Тогда
					Константы.ВКМ_НоменклатураАбонентскаяПлата.Установить(Номенклатура.Ссылка);
				ИначеЕсли Номер = 2 Тогда
					Константы.ВКМ_НоменклатураРаботыСпециалиста.Установить(Номенклатура.Ссылка);
				КонецЕсли;
			КонецЦикла;
			ДопУслуга = Номенклатура.Ссылка;
			Договоры = Новый Массив;
			Для Номер = 1 По 15 Цикл
				ИндексКлиента = Цел((Номер - 1) / 3);
				Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
				Договор.Наименование = Префикс + "Договор " + ВКМ_Номер(Номер);
				Договор.Владелец = Клиенты[ИндексКлиента];
				Договор.Организация = Организации[ИндексКлиента];
				Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание;
				Договор.ВКМ_АбонДатаНачала = Дата(ГодДемо - 1, 1, 1);
				Договор.ВКМ_АбонДатаОкончания = Дата(ГодДемо, 12, 31);
				Договор.ВКМ_АбонСуммаАбонПлаты = 10000;
				Договор.ВКМ_АбонСтоимостьЧаса = 1000;
				Договор.Записать();
				Договоры.Добавить(Договор.Ссылка);
			КонецЦикла;
			Для Месяц = 1 По 12 Цикл
				Если Месяц >= 8 Тогда
					ВКМ_ДемоПремия(Сотрудники, Дата(ГодДемо - 1, Месяц, 20), (Месяц - 8) * 3);
				КонецЕсли;
				ВКМ_ДемоНачисление(Сотрудники, Организации[0], Виды, Дата(ГодДемо - 1, Месяц, 1), Ложь);
				ВКМ_ДемоВыплата(Сотрудники, КонецМесяца(Дата(ГодДемо - 1, Месяц, 1)), 0, 15);
			КонецЦикла;
			Для Номер = 1 По 15 Цикл
				Договор = Договоры[Номер - 1];
				Документ = Документы.ВКМ_ОбслуживаниеКлиента.СоздатьДокумент();
				Документ.Дата = Дата(ГодДемо, 1, 15, 16, 0, 0);
				Документ.ВКМ_Клиент = Договор.Владелец;
				Документ.ВКМ_Договор = Договор;
				Документ.ВКМ_Специалист = Сотрудники[(Номер - 1) % 10];
				Документ.ВКМ_ДатаПроведенияРабот = Дата(ГодДемо, 1, 15);
				Документ.ВКМ_ВремяНачалаПлан = Дата(ГодДемо, 1, 15, 9, 0, 0);
				Документ.ВКМ_ВремяОкончанияПлан = Дата(ГодДемо, 1, 15, 15, 0, 0);
				Документ.ВКМ_ОписаниеПроблемы = Префикс + "Плановое обслуживание " + ВКМ_Номер(Номер);
				Для ВидРаботы = 1 По 3 Цикл
					Работа = Документ.ВКМ_ВыполненныеРаботы.Добавить();
					Работа.ВКМ_ОписаниеРабот = "Работа " + Строка(ВидРаботы);
					Работа.ВКМ_ФактЧасов = ВидРаботы;
					Работа.ВКМ_ЧасыКОплате = ВидРаботы;
				КонецЦикла;
				Документ.Записать(РежимЗаписиДокумента.Проведение);
				ВКМ_ДобавитьЛистУчета(Документ.Ссылка);
			КонецЦикла;
			Для Порция = 0 По 4 Цикл
				График = Документы.ВКМ_ГрафикОтпусков.СоздатьДокумент();
				График.Дата = Дата(ГодДемо, 1, 1);
				График.Год = ГодДемо;
				Для Номер = Порция * 3 По Порция * 3 + 2 Цикл
					Отпуск = График.ОтпускаСотрудников.Добавить();
					Отпуск.Сотрудник = Сотрудники[Номер];
					Отпуск.ДатаНачала = Дата(ГодДемо, 1, 5);
					Отпуск.ДатаКонца = Дата(ГодДемо, 1, 9);
				КонецЦикла;
				График.Записать(РежимЗаписиДокумента.Проведение);
				ВКМ_ДемоПремия(Сотрудники, Дата(ГодДемо, 1, 20), Порция * 3);
			КонецЦикла;
			ВКМ_ДемоНачисление(Сотрудники, Организации[0], Виды, Дата(ГодДемо, 1, 1), Истина);
			Для Порция = 0 По 4 Цикл
				ВКМ_ДемоВыплата(Сотрудники, КонецМесяца(Дата(ГодДемо, 1, 1)), Порция * 3, 3);
			КонецЦикла;
			// Первые три договора оставляем для создания актов в сквозном автотесте.
			ДоговорыДляАктов = Новый Массив;
			Для Индекс = 3 По Договоры.Количество() - 1 Цикл
				ДоговорыДляАктов.Добавить(Договоры[Индекс]);
			КонецЦикла;
			Акты = Обработки.ВКМ_МассовоеСозданиеАктов.СоздатьДокументыДляАбонентскихДоговоров(Дата(ГодДемо, 1, 1), Неопределено, ДоговорыДляАктов);
			Для Каждого Акт Из Акты Цикл
				Если Не Акт.Создан Тогда
					ВызватьИсключение Акт.Ошибка;
				КонецЕсли;
				// Третья самостоятельная услуга демонстрирует отбор отчета по номенклатуре.
				Реализация = Акт.ДокументРеализация.ПолучитьОбъект();
				ДопСтрока = Реализация.Услуги.Добавить();
				ДопСтрока.Номенклатура = ДопУслуга;
				ДопСтрока.Количество = 1;
				ДопСтрока.Цена = 2500;
				ДопСтрока.Сумма = 2500;
				Реализация.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;
			Состояние.Очистить();
			ЗаписьСостояния = Состояние.Добавить();
			ЗаписьСостояния.ВКМ_Год = ГодДемо;
			ЗаписьСостояния.ВКМ_Готово = Истина;
			Состояние.Записать();
			Результат = Префикс + "создано: 5 организаций, 5 клиентов, 15 договоров и сотрудников, 15 обслуживаний и 12 актов (3 договора оставлены для автотеста), история зарплаты за 12 месяцев, отпуска, премии и выплаты. Создайте тестовых пользователей отдельной командой";
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ВКМ_Элемент(Менеджер, Знач Имя)
	Ссылка = Менеджер.НайтиПоНаименованию(Имя, Истина);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Менеджер.СоздатьЭлемент();
		Объект.Наименование = Имя;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ВКМ_Номер(Знач Номер)
	Возврат Прав("0" + Формат(Номер, "ЧГ=0"), 2);
КонецФункции

Процедура ВКМ_ДемоНачисление(Сотрудники, Организация, Виды, Знач Месяц, Знач СОтпуском)
	Документ = Документы.ВКМ_НачислениеЗарплаты.СоздатьДокумент();
	Документ.Дата = КонецМесяца(Месяц) - 7200;
	Документ.Период = Месяц;
	Документ.Организация = Организация;
	Для Каждого Сотрудник Из Сотрудники Цикл
		Строка = Документ.Начисления.Добавить();
		Строка.Сотрудник = Сотрудник;
		Строка.ВКМ_ВидНачисления = Виды.Оклад;
		Если СОтпуском Тогда
			Строка = Документ.Начисления.Добавить();
			Строка.Сотрудник = Сотрудник;
			Строка.ВКМ_ВидНачисления = Виды.Процент;
			Строка = Документ.Начисления.Добавить();
			Строка.Сотрудник = Сотрудник;
			Строка.ВКМ_ВидНачисления = Виды.Отпуск;
			Строка.ВКМ_ДатаНачала = Дата(Год(Месяц), 1, 5);
			Строка.ВКМ_ДатаОкончания = Дата(Год(Месяц), 1, 9);
		КонецЕсли;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ВКМ_ДемоПремия(Сотрудники, Знач ДатаПремии, Знач Первый)
	Документ = Документы.ВКМ_НачислениеФиксированнойПремии.СоздатьДокумент();
	Документ.Дата = ДатаПремии;
	Для Номер = Первый По Первый + 2 Цикл
		Строка = Документ.СписокСотрудников.Добавить();
		Строка.Сотрудник = Сотрудники[Номер];
		Строка.СуммаПремии = 1500;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ВКМ_ДемоВыплата(Сотрудники, Знач ДатаВыплаты, Знач Первый, Знач Количество)
	Документ = Документы.ВКМ_ВыплатаЗарплаты.СоздатьДокумент();
	Документ.Дата = ДатаВыплаты;
	Для Номер = Первый По Первый + Количество - 1 Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ СуммаОстаток КАК Сумма
		|ИЗ РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.Остатки(&Момент, Сотрудник = &Сотрудник)");
		Запрос.УстановитьПараметр("Момент", ДатаВыплаты);
		Запрос.УстановитьПараметр("Сотрудник", Сотрудники[Номер]);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Сумма > 0 Тогда
			Строка = Документ.Выплаты.Добавить();
			Строка.Сотрудник = Сотрудники[Номер];
			Строка.Сумма = Выборка.Сумма;
		КонецЕсли;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

// Административная операция выполняется отдельно от транзакции хозяйственных данных.
Процедура ВКМ_СоздатьТестовыхПользователей(Знач ГодДемо, Знач ЭтоДемонстрационнаяБаза) Экспорт
	Если Не ЭтоДемонстрационнаяБаза Или Не РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение "Создание тестовых пользователей доступно администратору в демонстрационной базе";
	КонецЕсли;
	Префикс = "ДЕМО ВКМ " + Формат(ГодДемо, "ЧГ=0") + " ";
	ПользователиДемо = Новый Массив;
	ВКМ_ТестовыйПользователь("ВКМ_Демо_Специалист", Префикс + "Специалист 01", "Специалист", ПользователиДемо);
	ВКМ_ТестовыйПользователь("ВКМ_Демо_Менеджер", Префикс + "Администрация 11", "Менеджер", ПользователиДемо);
	ВКМ_ТестовыйПользователь("ВКМ_Демо_Бухгалтер", Префикс + "Администрация 12", "БухгалтерИТФирмы", ПользователиДемо);
	ВКМ_ТестовыйПользователь("ВКМ_Демо_Кадровик", Префикс + "Администрация 13", "КадровикРасчетчик", ПользователиДемо);
	УправлениеДоступом.ОбновитьРолиПользователей(ПользователиДемо);
	Если ПользователиИнформационнойБазы.НайтиПоИмени("Администратор") = Неопределено Тогда
		Администратор = ПользователиИнформационнойБазы.СоздатьПользователя();
		Администратор.Имя = "Администратор";
		Администратор.ПолноеИмя = "Администратор демонстрационной базы";
		Администратор.АутентификацияСтандартная = Истина;
		Администратор.Роли.Добавить(Метаданные.Роли.ПолныеПрава);
		Администратор.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура ВКМ_ТестовыйПользователь(Знач Логин, Знач ИмяСотрудника, Знач ИмяПрофиля, ПользователиДемо)
	Идентификаторы = ВКМ_ИдентификаторыПрофилей();
	Профиль = Справочники.ПрофилиГруппДоступа.НайтиПоРеквизиту("ИдентификаторПоставляемыхДанных", Идентификаторы[ИмяПрофиля]);
	Если Не ЗначениеЗаполнено(Профиль) Тогда
		ВызватьИсключение "Сначала завершите стандартное обновление профилей БСП: " + ИмяПрофиля;
	КонецЕсли;
	Пользователь = Справочники.Пользователи.НайтиПоНаименованию(ИмяСотрудника, Истина);
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение "Сначала создайте демонстрационные данные выбранного года";
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		ПользовательИБ.Имя = Логин;
		ПользовательИБ.ПолноеИмя = ИмяСотрудника;
		ПользовательИБ.АутентификацияСтандартная = Истина;
		ПользовательИБ.Роли.Добавить(Метаданные.Роли.ЗапускТонкогоКлиента);
		ПользовательИБ.Записать();
	КонецЕсли;
	Объект = Пользователь.ПолучитьОбъект();
	Описание = Новый Структура("Действие,УникальныйИдентификатор", "Записать", ПользовательИБ.УникальныйИдентификатор);
	Объект.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", Описание);
	Объект.Записать();
	ИмяГруппы = "ДЕМО ВКМ " + ИмяПрофиля;
	ГруппаСсылка = Справочники.ГруппыДоступа.НайтиПоНаименованию(ИмяГруппы, Истина);
	Если ЗначениеЗаполнено(ГруппаСсылка) Тогда
		Группа = ГруппаСсылка.ПолучитьОбъект();
	Иначе
		Группа = Справочники.ГруппыДоступа.СоздатьЭлемент();
		Группа.Наименование = ИмяГруппы;
	КонецЕсли;
	Группа.Профиль = Профиль;
	Найден = Ложь;
	Для Каждого Строка Из Группа.Пользователи Цикл
		Если Строка.Пользователь = Пользователь Тогда
			Найден = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не Найден Тогда
		Группа.Пользователи.Добавить().Пользователь = Пользователь;
	КонецЕсли;
	Группа.Записать();
	ПользователиДемо.Добавить(Пользователь);
КонецПроцедуры

Функция ВКМ_ИдентификаторыПрофилей()
	Идентификаторы = Новый Соответствие;
	Идентификаторы.Вставить("Специалист", Новый УникальныйИдентификатор("3cfd5b0e-1750-5cf4-93d6-fdc2027ac2b3"));
	Идентификаторы.Вставить("Менеджер", Новый УникальныйИдентификатор("efab9b85-80a8-5332-8590-8f3c9e8685c7"));
	Идентификаторы.Вставить("БухгалтерИТФирмы", Новый УникальныйИдентификатор("fe3f505b-1a8f-53a6-8886-e894219f8a22"));
	Идентификаторы.Вставить("КадровикРасчетчик", Новый УникальныйИдентификатор("4ca3befa-51d5-5e86-aba2-cc7fb560bccc"));
