КонецФункции

Процедура ВКМ_ДобавитьЛистУчета(Владелец)
	Файл = ПолучитьОбщийМакет("ВКМ_ДемоЛистУчета");
	Адрес = ПоместитьВоВременноеХранилище(Файл, Новый УникальныйИдентификатор);
	Параметры = РаботаСФайлами.ПараметрыДобавленияФайла();
	Параметры.ВладелецФайлов = Владелец;
	Параметры.ИмяБезРасширения = "Лист учета времени ДЕМО";
	Параметры.РасширениеБезТочки = "png";
	РаботаСФайлами.ДобавитьФайл(Параметры, Адрес, "", "Демонстрационный образец листа учета, не реальный подписанный документ");
	УдалитьИзВременногоХранилища(Адрес);
КонецПроцедуры
