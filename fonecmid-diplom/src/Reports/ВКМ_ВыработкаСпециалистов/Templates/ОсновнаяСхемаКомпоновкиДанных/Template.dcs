		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Обороты.ВКМ_Специалист КАК Специалист,
	Обороты.ВКМ_Специалист.Наименование КАК НаименованиеСпециалиста,
	СУММА(Обороты.ВКМ_КоличествоЧасовОборот) КАК Часов,
	СУММА(Обороты.ВКМ_СуммаКОплатеОборот) КАК СуммаНачисления
ИЗ
	РегистрНакопления.ВКМ_ВыполненныеКлиентуРаботы.Обороты КАК Обороты
ГДЕ
	Обороты.ВКМ_Специалист.Ссылка = &amp;Специалист

СГРУППИРОВАТЬ ПО
	Обороты.ВКМ_Специалист,
	Обороты.ВКМ_Специалист.Наименование

УПОРЯДОЧИТЬ ПО
	НаименованиеСпециалиста</query>
