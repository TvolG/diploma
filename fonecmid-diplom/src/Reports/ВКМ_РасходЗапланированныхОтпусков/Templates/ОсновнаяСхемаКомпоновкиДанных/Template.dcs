<?xml version='1.0' encoding='UTF-8'?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cfg="http://v8.1c.ru/8.1/data/enterprise/current-config">
  <dataSource>
    <name>ИсточникДанных</name>
    <dataSourceType>Local</dataSourceType>
  </dataSource>
  <dataSet xsi:type="DataSetQuery">
    <name>НаборДанных</name>
    <field xsi:type="DataSetFieldField">
      <dataPath>Сотрудник</dataPath>
      <field>Сотрудник</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Сотрудник</v8:content>
        </v8:item>
      </title>
      <role>
        <dcscom:dimension>true</dcscom:dimension>
      </role>
    </field>
    <field xsi:type="DataSetFieldField">
      <dataPath>ДнейПоПлану</dataPath>
      <field>ДнейПоПлану</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Запланировано дней</v8:content>
        </v8:item>
      </title>
    </field>
    <field xsi:type="DataSetFieldField">
      <dataPath>ДнейФактически</dataPath>
      <field>ДнейФактически</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Использовано дней</v8:content>
        </v8:item>
      </title>
    </field>
    <dataSource>ИсточникДанных</dataSource>
    <query>ВЫБРАТЬ
 Отпуска.Сотрудник КАК Сотрудник,
 Отпуска.КоличествоДнейПриход КАК ДнейПоПлану,
 Отпуска.КоличествоДнейРасход КАК ДнейФактически
ИЗ РегистрНакопления.ВКМ_ОстаткиОтпусковСотрудников.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , ) КАК Отпуска</query>
  </dataSet>
  <totalField>
    <dataPath>ДнейПоПлану</dataPath>
    <expression>Сумма(ДнейПоПлану)</expression>
  </totalField>
  <totalField>
    <dataPath>ДнейФактически</dataPath>
    <expression>Сумма(ДнейФактически)</expression>
  </totalField>
  <parameter>
    <name>НачалоПериода</name>
    <valueType>
      <v8:Type>xs:dateTime</v8:Type>
    </valueType>
    <value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
    <expression>&amp;Период.ДатаНачала</expression>
    <useRestriction>true</useRestriction>
    <use>Always</use>
  </parameter>
  <parameter>
    <name>КонецПериода</name>
    <valueType>
      <v8:Type>xs:dateTime</v8:Type>
    </valueType>
    <value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
    <expression>&amp;Период.ДатаОкончания</expression>
    <useRestriction>true</useRestriction>
    <use>Always</use>
  </parameter>
  <parameter>
    <name>Период</name>
    <title xsi:type="v8:LocalStringType">
      <v8:item>
        <v8:lang>ru</v8:lang>
        <v8:content>Период</v8:content>
      </v8:item>
    </title>
    <valueType>
      <v8:Type>v8:StandardPeriod</v8:Type>
    </valueType>
    <value xsi:type="v8:StandardPeriod">
      <v8:variant xsi:type="v8:StandardPeriodVariant">ThisYear</v8:variant>
    </value>
    <useRestriction>true</useRestriction>
    <use>Always</use>
  </parameter>
  <parameter>
    <name>Год</name>
    <title xsi:type="v8:LocalStringType">
      <v8:item>
        <v8:lang>ru</v8:lang>
        <v8:content>Год</v8:content>
      </v8:item>
    </title>
    <valueType>
      <v8:Type>xs:decimal</v8:Type>
    </valueType>
    <value xsi:type="xs:decimal">0</value>
    <use>Always</use>
  </parameter>
  <settingsVariant>
    <dcsset:name>Основной</dcsset:name>
    <dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
    <dcsset:settings>
      <dcsset:dataParameters>
        <dcscor:item xsi:type="dcsset:SettingsParameterValue">
          <dcscor:use>true</dcscor:use>
          <dcscor:parameter>Год</dcscor:parameter>
          <dcscor:value xsi:type="xs:decimal">0</dcscor:value>
          <dcsset:userSettingID>9eb84c73-4200-4dfb-907b-c7f45aefdb6b</dcsset:userSettingID>
        </dcscor:item>
      </dcsset:dataParameters>
      <dcsset:item xsi:type="dcsset:StructureItemGroup">
        <dcsset:selection>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>Сотрудник</dcsset:field>
          </dcsset:item>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>ДнейПоПлану</dcsset:field>
          </dcsset:item>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>ДнейФактически</dcsset:field>
          </dcsset:item>
        </dcsset:selection>
      </dcsset:item>
    </dcsset:settings>
  </settingsVariant>
</DataCompositionSchema>
