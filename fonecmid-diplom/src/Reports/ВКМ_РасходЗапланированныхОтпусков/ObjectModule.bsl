Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	ПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	ПараметрГода = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Год"));
	ГодОтчета = ПараметрГода.Значение;
	Если Не ЗначениеЗаполнено(ГодОтчета) Тогда
		ГодОтчета = Год(ТекущаяДатаСеанса());
	КонецЕсли;
	Если ГодОтчета < 1900 Или ГодОтчета > 9999 Или ГодОтчета <> Цел(ГодОтчета) Тогда
		ВызватьИсключение "Укажите год от 1900 до 9999";
	КонецЕсли;
	ПараметрыДанных.УстановитьЗначениеПараметра("Год", ГодОтчета);
	ПериодГода = Новый СтандартныйПериод;
	ПериодГода.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	ПериодГода.ДатаНачала = Дата(ГодОтчета, 1, 1);
	ПериодГода.ДатаОкончания = КонецГода(ПериодГода.ДатаНачала);
	ПараметрыДанных.УстановитьЗначениеПараметра("Период", ПериодГода);
КонецПроцедуры
