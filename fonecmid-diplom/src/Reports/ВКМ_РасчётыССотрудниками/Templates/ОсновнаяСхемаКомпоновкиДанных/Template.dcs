<?xml version='1.0' encoding='UTF-8'?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cfg="http://v8.1c.ru/8.1/data/enterprise/current-config">
  <dataSource>
    <name>ИсточникДанных</name>
    <dataSourceType>Local</dataSourceType>
  </dataSource>
  <dataSet xsi:type="DataSetQuery">
    <name>НаборДанных</name>
    <field xsi:type="DataSetFieldField">
      <dataPath>Сотрудник</dataPath>
      <field>Сотрудник</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Сотрудник</v8:content>
        </v8:item>
      </title>
      <role>
        <dcscom:dimension>true</dcscom:dimension>
      </role>
    </field>
    <field xsi:type="DataSetFieldField">
      <dataPath>ДолгНаНачало</dataPath>
      <field>ДолгНаНачало</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Долг на начало</v8:content>
        </v8:item>
      </title>
    </field>
    <field xsi:type="DataSetFieldField">
      <dataPath>НачисленоКВыплате</dataPath>
      <field>НачисленоКВыплате</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Начислено к выплате</v8:content>
        </v8:item>
      </title>
    </field>
    <field xsi:type="DataSetFieldField">
      <dataPath>Выплачено</dataPath>
      <field>Выплачено</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Выплачено</v8:content>
        </v8:item>
      </title>
    </field>
    <field xsi:type="DataSetFieldField">
      <dataPath>ДолгНаКонец</dataPath>
      <field>ДолгНаКонец</field>
      <title xsi:type="v8:LocalStringType">
        <v8:item>
          <v8:lang>ru</v8:lang>
          <v8:content>Долг на конец</v8:content>
        </v8:item>
      </title>
    </field>
    <dataSource>ИсточникДанных</dataSource>
    <query>ВЫБРАТЬ
 Расчеты.Сотрудник КАК Сотрудник,
 Расчеты.СуммаНачальныйОстаток КАК ДолгНаНачало,
 Расчеты.СуммаПриход КАК НачисленоКВыплате,
 Расчеты.СуммаРасход КАК Выплачено,
 Расчеты.СуммаКонечныйОстаток КАК ДолгНаКонец
ИЗ РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , ) КАК Расчеты</query>
  </dataSet>
  <totalField>
    <dataPath>ДолгНаНачало</dataPath>
    <expression>Сумма(ДолгНаНачало)</expression>
  </totalField>
  <totalField>
    <dataPath>НачисленоКВыплате</dataPath>
    <expression>Сумма(НачисленоКВыплате)</expression>
  </totalField>
  <totalField>
    <dataPath>Выплачено</dataPath>
    <expression>Сумма(Выплачено)</expression>
  </totalField>
  <totalField>
    <dataPath>ДолгНаКонец</dataPath>
    <expression>Сумма(ДолгНаКонец)</expression>
  </totalField>
  <parameter>
    <name>НачалоПериода</name>
    <valueType>
      <v8:Type>xs:dateTime</v8:Type>
    </valueType>
    <value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
    <expression>&amp;Период.ДатаНачала</expression>
    <useRestriction>true</useRestriction>
    <use>Always</use>
  </parameter>
  <parameter>
    <name>КонецПериода</name>
    <valueType>
      <v8:Type>xs:dateTime</v8:Type>
    </valueType>
    <value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
    <expression>&amp;Период.ДатаОкончания</expression>
    <useRestriction>true</useRestriction>
    <use>Always</use>
  </parameter>
  <parameter>
    <name>Период</name>
    <title xsi:type="v8:LocalStringType">
      <v8:item>
        <v8:lang>ru</v8:lang>
        <v8:content>Период</v8:content>
      </v8:item>
    </title>
    <valueType>
      <v8:Type>v8:StandardPeriod</v8:Type>
    </valueType>
    <value xsi:type="v8:StandardPeriod">
      <v8:variant xsi:type="v8:StandardPeriodVariant">ThisMonth</v8:variant>
    </value>
    <useRestriction>false</useRestriction>
    <use>Always</use>
  </parameter>
  <settingsVariant>
    <dcsset:name>Основной</dcsset:name>
    <dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
    <dcsset:settings>
      <dcsset:dataParameters>
        <dcscor:item xsi:type="dcsset:SettingsParameterValue">
          <dcscor:use>true</dcscor:use>
          <dcscor:parameter>Период</dcscor:parameter>
          <dcscor:value xsi:type="v8:StandardPeriod">
            <v8:variant xsi:type="v8:StandardPeriodVariant">ThisMonth</v8:variant>
          </dcscor:value>
          <dcsset:userSettingID>e6f42f85-b842-47e0-b5e9-680755fe4f8b</dcsset:userSettingID>
        </dcscor:item>
      </dcsset:dataParameters>
      <dcsset:item xsi:type="dcsset:StructureItemGroup">
        <dcsset:selection>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>Сотрудник</dcsset:field>
          </dcsset:item>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>ДолгНаНачало</dcsset:field>
          </dcsset:item>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>НачисленоКВыплате</dcsset:field>
          </dcsset:item>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>Выплачено</dcsset:field>
          </dcsset:item>
          <dcsset:item xsi:type="dcsset:SelectedItemField">
            <dcsset:field>ДолгНаКонец</dcsset:field>
          </dcsset:item>
        </dcsset:selection>
      </dcsset:item>
    </dcsset:settings>
  </settingsVariant>
</DataCompositionSchema>
