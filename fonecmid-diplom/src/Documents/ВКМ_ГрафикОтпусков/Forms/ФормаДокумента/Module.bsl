&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("ВКМ_ДлительностьДней", Новый ОписаниеТипов("Число"), "Объект.ОтпускаСотрудников"));
	ИзменитьРеквизиты(НовыеРеквизиты);
	ВКМ_ОбновитьДлительности();
	Если Не ЗначениеЗаполнено(Объект.Год) Тогда
		Объект.Год = Год(ТекущаяДатаСеанса());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Оформление = УсловноеОформление.Элементы.Добавить();
	Оформление.Использование = Истина;
	Поле = Оформление.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ОтпускаСотрудников");
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 200, 200));
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255, 0, 0));
	
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ОтпускаСотрудников.ВКМ_ДлительностьДней");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Отбор.ПравоеЗначение = 28;
	Отбор.Использование = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАнализГрафика(Команда)
	
	Если Объект.ОтпускаСотрудников.Количество() = 0 Тогда
		Сообщить("Нет данных для анализа");
		Возврат;
	КонецЕсли;
	
	АдресВременногоХранилища = ПолучитьДанныеДляГантаНаСервереИСохранить();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресДанных", АдресВременногоХранилища);
	ПараметрыФормы.Вставить("Год", Объект.Год);
	
	ОткрытьФорму("Документ.ВКМ_ГрафикОтпусков.Форма.АнализГрафика", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляГантаНаСервереИСохранить()
	
	Данные = Новый Структура;
	Данные.Вставить("Сотрудники", Новый Массив);
	Данные.Вставить("Имена", Новый Массив);
	Данные.Вставить("ДатыНачала", Новый Массив);
	Данные.Вставить("ДатыОкончания", Новый Массив);
	Данные.Вставить("Длительности", Новый Массив);
	
	Для Каждого Строка Из Объект.ОтпускаСотрудников Цикл
		Данные.Сотрудники.Добавить(Строка.Сотрудник);
		Данные.Имена.Добавить(Строка.Сотрудник.Наименование);
		Данные.ДатыНачала.Добавить(Строка.ДатаНачала);
		Данные.ДатыОкончания.Добавить(Строка.ДатаКонца);
		Данные.Длительности.Добавить((НачалоДня(Строка.ДатаКонца) - НачалоДня(Строка.ДатаНачала)) / 86400 + 1);
	КонецЦикла;
	
	Адрес = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	
	Возврат Адрес;
	
КонецФункции
&НаСервере
Процедура ВКМ_ОбновитьДлительности()
	Итоги = Новый Соответствие;
	Для Каждого Строка Из Объект.ОтпускаСотрудников Цикл
		Дней = 0;
		Если ЗначениеЗаполнено(Строка.ДатаНачала) И ЗначениеЗаполнено(Строка.ДатаКонца) И Строка.ДатаКонца >= Строка.ДатаНачала Тогда
			Дней = (НачалоДня(Строка.ДатаКонца) - НачалоДня(Строка.ДатаНачала)) / 86400 + 1;
		КонецЕсли;
		СуммаДней = Итоги.Получить(Строка.Сотрудник);
		Если СуммаДней = Неопределено Тогда
			СуммаДней = 0;
		КонецЕсли;
		Итоги.Вставить(Строка.Сотрудник, СуммаДней + Дней);
	КонецЦикла;
	Для Каждого Строка Из Объект.ОтпускаСотрудников Цикл
		Строка.ВКМ_ДлительностьДней = Итоги.Получить(Строка.Сотрудник);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_ДатыОтпускаПриИзменении(Элемент)
	ВКМ_ОбновитьДлительности();
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_ДвиженияОстаткиОтпусковСотрудников(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите документ");
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("Регистратор", Объект.Ссылка);
	ОткрытьФорму("РегистрНакопления.ВКМ_ОстаткиОтпусковСотрудников.ФормаСписка", Новый Структура("Отбор", Отбор), ЭтаФорма);
КонецПроцедуры
