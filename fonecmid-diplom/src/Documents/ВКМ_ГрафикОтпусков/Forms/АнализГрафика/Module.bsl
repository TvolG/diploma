&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не Параметры.Свойство("Год") Или Не Параметры.Свойство("АдресДанных") Тогда
		ВызватьИсключение "Откройте анализ из документа графика отпусков";
	КонецЕсли;
	ГодШкалы = Параметры.Год;
	ВКМ_Год = ГодШкалы;
	ВКМ_Месяц = 0;
	Если ГодШкалы < 1900 Или ГодШкалы > 9999 Тогда
		ВызватьИсключение "Некорректный год графика";
	КонецЕсли;
	Данные = ПолучитьИзВременногоХранилища(Параметры.АдресДанных);
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Данные графика устарели; откройте анализ повторно";
	КонецЕсли;
	УдалитьИзВременногоХранилища(Параметры.АдресДанных);
	ГрафикОтпусков.Обновление = Ложь;
	ГрафикОтпусков.Точки.Очистить();
	ГрафикОтпусков.Серии.Очистить();
	ГрафикОтпусков.АвтоОпределениеПолногоИнтервала = Ложь;
	ГрафикОтпусков.УстановитьПолныйИнтервал(Дата(ГодШкалы, 1, 1), КонецГода(Дата(ГодШкалы, 1, 1)));
	Серия = ГрафикОтпусков.Серии.Добавить();
	Серия.Текст = "Плановый отпуск";
	Серия.Цвет = Новый Цвет(0, 128, 255);
	Точки = Новый Соответствие;
	Для Индекс = 0 По Данные.Сотрудники.Количество() - 1 Цикл
		Начало = Данные.ДатыНачала[Индекс];
		Конец = Данные.ДатыОкончания[Индекс];
		Если Не ЗначениеЗаполнено(Начало) Или Конец < Начало Тогда
			Продолжить;
		КонецЕсли;
		Начало = Макс(НачалоДня(Начало), Дата(ГодШкалы, 1, 1));
		Конец = Мин(КонецДня(Конец), КонецГода(Дата(ГодШкалы, 1, 1)));
		Если Конец < Начало Тогда
			Продолжить;
		КонецЕсли;
		Сотрудник = Данные.Сотрудники[Индекс];
		Точка = Точки.Получить(Сотрудник);
		Если Точка = Неопределено Тогда
			Точка = ГрафикОтпусков.Точки.Добавить();
			Точка.Текст = Данные.Имена[Индекс];
			Точки.Вставить(Сотрудник, Точка);
		КонецЕсли;
		Интервал = ГрафикОтпусков.ПолучитьЗначение(Точка, Серия).Добавить();
		Интервал.Начало = Начало;
		Интервал.Конец = Конец;
		Интервал.Текст = Формат(Начало, "ДФ=dd.MM") + " - " + Формат(Конец, "ДФ=dd.MM")
			+ ": " + Строка((НачалоДня(Конец) - НачалоДня(Начало)) / 86400 + 1) + " дн.";
	КонецЦикла;
	ВКМ_НастроитьМасштаб();
	Элементы.ВКМ_Месяц.РежимВыбораИзСписка = Истина;
	Элементы.ВКМ_Месяц.СписокВыбора.Добавить(0, "Весь год");
	Для Месяц = 1 По 12 Цикл
		Элементы.ВКМ_Месяц.СписокВыбора.Добавить(Месяц, Формат(Дата(ГодШкалы, Месяц, 1), "ДФ=MMMM"));
	КонецЦикла;
	ГрафикОтпусков.Обновление = Истина;
КонецПроцедуры


&НаКлиенте
Процедура ВКМ_МасштабПриИзменении(Элемент)
	ВКМ_НастроитьМасштаб();
КонецПроцедуры

&НаСервере
Процедура ВКМ_НастроитьМасштаб()
	Если ВКМ_Месяц < 0 Или ВКМ_Месяц > 12 Или ВКМ_Месяц <> Цел(ВКМ_Месяц) Тогда
		ВызватьИсключение "Выберите весь год или месяц из списка";
	КонецЕсли;
	ГрафикОтпусков.Обновление = Ложь;
	ГрафикОтпусков.АвтоОпределениеПолногоИнтервала = Ложь;
	ГрафикОтпусков.ОтображениеИнтервала = ОтображениеИнтервалаДиаграммыГанта.Плоский;
	ГрафикОтпусков.ОбластьЛегенды.Расположение = РасположениеЛегендыДиаграммы.Нет;
	Шкала = ГрафикОтпусков.ОбластьПостроения.ШкалаВремени.Элементы;
	// Как в штатном отчете АнализЖурналаРегистрации: оставить один элемент и настроить его.
	Если Шкала.Количество() = 0 Тогда
		Шкала.Добавить();
	КонецЕсли;
	Пока Шкала.Количество() > 1 Цикл
		Шкала.Удалить(Шкала[1]);
	КонецЦикла;
	Шкала[0].Единица = ТипЕдиницыШкалыВремени.Месяц;
	Шкала[0].ЛинииДелений = Новый Линия(ТипЛинииДиаграммы.Сплошная, 1);
	Если ВКМ_Месяц = 0 Тогда
		ГрафикОтпусков.УстановитьПолныйИнтервал(Дата(ВКМ_Год, 1, 1), КонецГода(Дата(ВКМ_Год, 1, 1)));
	Иначе
		НачалоМасштаба = Дата(ВКМ_Год, ВКМ_Месяц, 1);
		ГрафикОтпусков.УстановитьПолныйИнтервал(НачалоМасштаба, КонецМесяца(НачалоМасштаба));
		Дни = Шкала.Добавить();
		Дни.Единица = ТипЕдиницыШкалыВремени.День;
		Дни.ФорматДня = ФорматДняШкалыВремени.ДеньМесяца;
		Дни.ЛинииДелений = Новый Линия(ТипЛинииДиаграммы.Точечная, 1);
	КонецЕсли;
	ГрафикОтпусков.Обновление = Истина;
КонецПроцедуры
