Процедура ОбработкаПроведения(Отказ, Режим)
	Если Год < 1900 Или Год > 9999 Или Год <> Цел(Год) Тогда
		ВызватьИсключение "Укажите год графика отпусков";
	КонецЕсли;
	Движения.ВКМ_ОстаткиОтпусковСотрудников.Очистить();
	Движения.ВКМ_ОстаткиОтпусковСотрудников.Записывать = Истина;
	Для Каждого Строка Из ОтпускаСотрудников Цикл
		Если Не ЗначениеЗаполнено(Строка.Сотрудник) Или Не ЗначениеЗаполнено(Строка.ДатаНачала)
			Или Не ЗначениеЗаполнено(Строка.ДатаКонца) Или Строка.ДатаКонца < Строка.ДатаНачала Тогда
			ВызватьИсключение "Заполните сотрудника и корректные даты каждой строки отпуска";
		КонецЕсли;
		Если Год(Строка.ДатаНачала) <> Год Или Год(Строка.ДатаКонца) <> Год Тогда
			ВызватьИсключение "Даты отпуска должны находиться в году графика; переходящий отпуск разделите по годам";
		КонецЕсли;
		Для Каждого Другая Из ОтпускаСотрудников Цикл
			Если Другая.НомерСтроки >= Строка.НомерСтроки Тогда
				Прервать;
			КонецЕсли;
			Если Другая.Сотрудник = Строка.Сотрудник И Другая.ДатаНачала <= Строка.ДатаКонца И Другая.ДатаКонца >= Строка.ДатаНачала Тогда
				ВызватьИсключение "Пересекаются плановые отпуска одного сотрудника";
			КонецЕсли;
		КонецЦикла;
		День = НачалоДня(Строка.ДатаНачала);
		Пока День <= НачалоДня(Строка.ДатаКонца) Цикл
			Движение = Движения.ВКМ_ОстаткиОтпусковСотрудников.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = День;
			Движение.Сотрудник = Строка.Сотрудник;
			Движение.КоличествоДней = 1;
			День = День + 86400;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
