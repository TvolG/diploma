// ВКМ_Начало: печать акта подключена через стандартный механизм БСП.
Процедура ПриОпределенииНастроекПечати(НастройкиОбъекта) Экспорт
	НастройкиОбъекта.ПриДобавленииКомандПечати = Истина;
КонецПроцедуры

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	Команда = КомандыПечати.Добавить();
	Команда.Идентификатор = "ВКМ_АктОбОказанныхУслугах";
	Команда.Представление = "Акт об оказанных услугах";
	Команда.Порядок = 10;
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Форма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "ВКМ_АктОбОказанныхУслугах");
	Если Форма <> Неопределено Тогда
		Форма.ТабличныйДокумент = ВКМ_СформироватьАкт(МассивОбъектов, ОбъектыПечати);
		Форма.СинонимМакета = "Акт об оказанных услугах";
		Форма.ПолныйПутьКМакету = "ОбщийМакет.ВКМ_МакетАктаОбОказанныхУслугах";
	КонецЕсли;
КонецПроцедуры

Функция ВКМ_СформироватьАкт(МассивОбъектов, ОбъектыПечати)
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ВКМ_МакетАктаОбОказанныхУслугах");
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "ВКМ_Акт";
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Реализация.Ссылка КАК Ссылка, Реализация.Дата КАК Дата,
	| Реализация.Номер КАК Номер, Реализация.Договор КАК Договор,
	| Реализация.Контрагент КАК Контрагент, Реализация.Организация КАК Организация,
	| Реализация.Ответственный КАК Ответственный, Реализация.СуммаДокумента КАК СуммаДокумента,
	| Реализация.Товары.(Номенклатура, Количество, Цена, Сумма) КАК Товары,
	| Реализация.Услуги.(Номенклатура, Количество, Цена, Сумма) КАК Услуги
	|ИЗ Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ Реализация.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", МассивОбъектов);
	Выборка = Запрос.Выполнить().Выбрать();
	Первый = Истина;
	Пока Выборка.Следующий() Цикл
		Если Не Первый Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		Первый = Ложь;
		НачалоПечати = ТабДок.ВысотаТаблицы + 1;
		ТабДок.Вывести(Макет.ПолучитьОбласть("Заголовок"));
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка);
		ТабДок.Вывести(Макет.ПолучитьОбласть("УслугиШапка"));
		ТабличныеЧасти = Новый Массив;
		ТабличныеЧасти.Добавить(Выборка.Товары);
		ТабличныеЧасти.Добавить(Выборка.Услуги);
		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
			Услуги = ТабличнаяЧасть.Выбрать();
			Пока Услуги.Следующий() Цикл
				Строка = Макет.ПолучитьОбласть("Услуги");
				Строка.Параметры.Заполнить(Услуги);
				ТабДок.Вывести(Строка);
			КонецЦикла;
		КонецЦикла;
		Подвал = Макет.ПолучитьОбласть("Подвал");
		Подвал.Параметры.Ответственный = Выборка.Ответственный;
		Подвал.Параметры.СуммаДокумента = Формат(Выборка.СуммаДокумента, "ЧДЦ=2");
		Подвал.Параметры.СуммаПрописью = ЧислоПрописью(Выборка.СуммаДокумента,
			"Л=ru_RU; ДП=Истина", "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
		ТабДок.Вывести(Подвал);
		ТабДок.Вывести(Макет.ПолучитьОбласть("Подписи"));
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НачалоПечати, ОбъектыПечати, Выборка.Ссылка);
	КонецЦикла;
	Возврат ТабДок;
КонецФункции
// ВКМ_Конец.
