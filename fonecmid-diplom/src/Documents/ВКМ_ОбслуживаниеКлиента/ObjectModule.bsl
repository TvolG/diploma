//ВКМ Начало изменений: Проверка по виду договора, датам и заполнение движений
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если Не ЗначениеЗаполнено(ВКМ_Договор) Или ВКМ_Договор.Владелец <> ВКМ_Клиент Тогда
		Отказ = Истина;
		Сообщить("Выберите договор указанного клиента");
		Возврат;
	КонецЕсли;
	ПроцентОтРабот = 0;
	
	Если ВКМ_Договор.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда  
		Отказ = Истина;
		Сообщить("Данный договор не является абонентским обслуживанием");
		Возврат;
	КонецЕсли;
	
	Если Дата < ВКМ_Договор.ВКМ_АбонДатаНачала ИЛИ Дата > КонецДня(ВКМ_Договор.ВКМ_АбонДатаОкончания) Тогда
		Сообщить("Дата документа выходит за пределы действия договора");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВКМ_Специалист) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	УсловияОплатыСотрудников.ПроцентОтРабот КАК ПроцентОтРабот
		|ИЗ
		|	РегистрСведений.ВКМ_УсловияОплатыСотрудников КАК УсловияОплатыСотрудников
		|ГДЕ
		|	УсловияОплатыСотрудников.Сотрудник = &Сотрудник
		|	И УсловияОплатыСотрудников.Период <= &ДатаДокумента
		|
		|УПОРЯДОЧИТЬ ПО
		|	УсловияОплатыСотрудников.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Сотрудник", ВКМ_Специалист);
		Запрос.УстановитьПараметр("ДатаДокумента", НачалоМесяца(Дата));
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПроцентОтРабот = Выборка.ПроцентОтРабот;
		Иначе
			Отказ = Истина;      
			Сообщить(СтрШаблон("Для специалиста %1 не установлен процент оплаты от работ на дату %2",ВКМ_Специалист,Формат(Дата, "ДФ=dd.MM.yyyy")));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВКМ_Специалист) Тогда
		ВызватьИсключение "Укажите специалиста";
	КонецЕсли;
	ВсегоЧасов = 0;
	ВсегоСумма = 0;
	
	Для Каждого Строка Из ВКМ_ВыполненныеРаботы Цикл
		Если Строка.ВКМ_ЧасыКОплате < 0 Или Строка.ВКМ_ФактЧасов < 0 Тогда
			ВызватьИсключение "Количество часов не может быть отрицательным";
		КонецЕсли;
		ВсегоЧасов = ВсегоЧасов + Строка.ВКМ_ЧасыКОплате;
		ВсегоСумма = ВсегоСумма + (Строка.ВКМ_ЧасыКОплате * ВКМ_Договор.ВКМ_АбонСтоимостьЧаса);
	КонецЦикла;
	
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Очистить();
	
	Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.ВКМ_Клиент = ВКМ_Клиент;
	Движение.ВКМ_Договор = ВКМ_Договор;
	Движение.ВКМ_КоличествоЧасов = ВсегоЧасов;
	Движение.ВКМ_СуммаКОплате = ВсегоСумма; 
	Движение.ВКМ_Специалист = ВКМ_Специалист;
	

	Движения.ВКМ_ВыполненныеСотрудникомРаботы.Записывать = Истина;
	Движения.ВКМ_ВыполненныеСотрудникомРаботы.Очистить();
	Вознаграждение = Движения.ВКМ_ВыполненныеСотрудникомРаботы.Добавить();
	Вознаграждение.Период = Дата;
	Вознаграждение.ВКМ_Сотрудник = ВКМ_Специалист;
	Вознаграждение.ВКМ_ЧасовКОплате = ВсегоЧасов;
	Вознаграждение.ВКМ_СуммаКОплате = Окр(ВсегоСумма * ПроцентОтРабот / 100, 2);

КонецПроцедуры
//ВКМ Конец изменений
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВКМ_Клиент) Или Не ЗначениеЗаполнено(ВКМ_Специалист)
		Или Не ЗначениеЗаполнено(ВКМ_ДатаПроведенияРабот)
		Или Не ЗначениеЗаполнено(ВКМ_ВремяНачалаПлан) Или ВКМ_ВремяОкончанияПлан <= ВКМ_ВремяНачалаПлан Тогда
		ВызватьИсключение "Укажите клиента, специалиста, дату и корректное плановое время обслуживания";
	КонецЕсли;
КонецПроцедуры
