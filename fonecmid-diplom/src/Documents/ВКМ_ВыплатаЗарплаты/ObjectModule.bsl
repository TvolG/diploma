Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;

	Для Каждого Строка Из Выплаты Цикл
		Если Не ЗначениеЗаполнено(Строка.Сотрудник) Или Строка.Сумма < 0 Тогда
			ВызватьИсключение "Укажите сотрудника и неотрицательную сумму выплаты";
		КонецЕсли;

		Если Строка.Сумма > 0 Тогда
			Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Сотрудник = Строка.Сотрудник;
			Движение.Сумма = Строка.Сумма;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
