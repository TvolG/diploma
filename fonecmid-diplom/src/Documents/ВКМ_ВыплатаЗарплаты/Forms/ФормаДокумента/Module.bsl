&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Объект.Выплаты.Очистить();
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ДатаДокумента = Новый Граница(Новый МоментВремени(Объект.Дата, Объект.Ссылка), ВидГраницы.Исключая);
	Иначе
		ДатаДокумента = Новый Граница(Объект.Дата, ВидГраницы.Включая);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВзаиморасчетыССотрудниками.Сотрудник КАК Сотрудник,
	|	СУММА(ВзаиморасчетыССотрудниками.СуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.Остатки(&ДатаДокумента) КАК ВзаиморасчетыССотрудниками
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыССотрудниками.Сотрудник
	|ИМЕЮЩИЕ
	|	СУММА(ВзаиморасчетыССотрудниками.СуммаОстаток) > 0";
	
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Строка = Объект.Выплаты.Добавить();
		Строка.Сотрудник = ВыборкаДетальныеЗаписи.Сотрудник;
		Строка.Сумма = ВыборкаДетальныеЗаписи.Сумма;
	КонецЦикла;
	
КонецПроцедуры      

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.Проведен Тогда
		Элементы.Заполнить.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ВКМ_ДвиженияВзаиморасчетыССотрудниками(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите документ");
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("Регистратор", Объект.Ссылка);
	ОткрытьФорму("РегистрНакопления.ВКМ_ВзаиморасчетыССотрудниками.ФормаСписка", Новый Структура("Отбор", Отбор), ЭтаФорма);
КонецПроцедуры
