Процедура ОбработкаПроведения(Отказ, Режим)
	Если НачалоМесяца(Дата) <> НачалоМесяца(Период) Тогда
		ВызватьИсключение "Дата документа и месяц начисления должны относиться к одному месяцу";
	КонецЕсли;
	Виды = ВКМ_РасчетЗарплаты.ВКМ_ВидыРасчета();
	ВКМ_РасчетЗарплаты.ВКМ_ПроверитьСтроки(ЭтотОбъект, Виды);
	ВКМ_РасчетЗарплаты.ВКМ_ЗаблокироватьСотрудников(Начисления);
	ВКМ_РасчетЗарплаты.ВКМ_ПроверитьЧужиеНачисления(ЭтотОбъект);
	НормаМесяца = ВКМ_РасчетЗарплаты.ВКМ_ПроверитьКалендарь(НачалоМесяца(Период), КонецМесяца(Период));
	Если НормаМесяца = 0 Тогда
		ВызватьИсключение "В месяце начисления нет рабочих дней по календарю";
	КонецЕсли;
	Движения.ВКМ_ОсновныеНачисления.Очистить();
	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Очистить();
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Движения.ВКМ_ОстаткиОтпусковСотрудников.Очистить();
	Движения.ВКМ_ОстаткиОтпусковСотрудников.Записывать = Истина;

	Для Каждого Строка Из Начисления Цикл
		Строка.Оклад = 0;
		Строка.ПроцентОтРабот = 0;
		Строка.ВКМ_СуммаОтпускных = 0;
		Строка.КоличествоДнейОтпуска = 0;
		Строка.ВКМ_НормаДней = 0;
		Строка.ВКМ_ФактДней = 0;
		Запись = Движения.ВКМ_ОсновныеНачисления.Добавить();
		Запись.ПериодРегистрации = Дата;
		Запись.ПериодДействияНачало = Строка.ВКМ_ДатаНачала;
		Запись.ПериодДействияКонец = КонецДня(Строка.ВКМ_ДатаОкончания);
		Запись.Сотрудник = Строка.Сотрудник;
		Запись.ВидРасчета = Строка.ВКМ_ВидНачисления;
		Запись.ВКМ_СтрокаДокумента = Строка.НомерСтроки;
		Запись.ВКМ_ДатаРаботНачало = Строка.ВКМ_ДатаРаботНачало;
		Запись.ВКМ_ДатаРаботКонец = Строка.ВКМ_ДатаРаботКонец;
		Если Строка.ВКМ_ВидНачисления = Виды.Отпуск Тогда
			Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Строка.ВКМ_ДатаНачала), -12);
			Запись.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(Строка.ВКМ_ДатаНачала, -1));
			ВКМ_РасчетЗарплаты.ВКМ_ПроверитьКалендарь(Запись.БазовыйПериодНачало, Запись.БазовыйПериодКонец);
		КонецЕсли;
	КонецЦикла;
	// Сначала записываем периоды: платформа вычислит вытеснение оклада отпуском.
	Движения.ВКМ_ОсновныеНачисления.Записать();
	График = ВКМ_РасчетЗарплаты.ВКМ_ДанныеГрафика(Ссылка);
	Для Каждого Запись Из Движения.ВКМ_ОсновныеНачисления Цикл
		Строка = Начисления[Запись.ВКМ_СтрокаДокумента - 1];
		ДанныеДней = График.Найти(Запись.НомерСтроки, "НомерСтроки");
		Если ДанныеДней = Неопределено Тогда
			ВызватьИсключение "Платформа не вернула данные графика для строки начисления";
		КонецЕсли;
		Если Запись.ВидРасчета = Виды.Оклад Тогда
			Условия = ВКМ_РасчетЗарплаты.ВКМ_УсловияОплаты(Строка.Сотрудник, Строка.ВКМ_ДатаНачала);
			Строка.ВКМ_НормаДней = НормаМесяца;
			Строка.ВКМ_ФактДней = ДанныеДней.Факт;
			Строка.Оклад = Окр(Условия.Оклад * ДанныеДней.Факт / НормаМесяца, 2);
			Запись.Сумма = Строка.Оклад;
		ИначеЕсли Запись.ВидРасчета = Виды.Процент Тогда
			Строка.ПроцентОтРабот = Окр(ВКМ_РасчетЗарплаты.ВКМ_ВознаграждениеЗаРаботы(
				Строка.Сотрудник, Строка.ВКМ_ДатаРаботНачало, Строка.ВКМ_ДатаРаботКонец), 2);
			Запись.Сумма = Строка.ПроцентОтРабот;
		КонецЕсли;
	КонецЦикла;
	// Для базы нужны уже рассчитанные основные начисления; отпуск использует предшествующие 12 полных месяцев.
	Движения.ВКМ_ОсновныеНачисления.Записать();
	Базы = ВКМ_РасчетЗарплаты.ВКМ_БазаОтпуска(Ссылка);
	Для Каждого Запись Из Движения.ВКМ_ОсновныеНачисления Цикл
		Строка = Начисления[Запись.ВКМ_СтрокаДокумента - 1];
		Если Запись.ВидРасчета = Виды.Отпуск Тогда
			ДанныеДней = График.Найти(Запись.НомерСтроки, "НомерСтроки");
			Если ДанныеДней.РабочихДнейБазы <= 0 Тогда
				ВызватьИсключение "В базе отпускных нет рабочих дней; проверьте календарь";
			КонецЕсли;
			СтрокаБазы = Базы.Найти(Запись.НомерСтроки, "НомерСтроки");
			СуммаБазы = ?(СтрокаБазы = Неопределено, 0, СтрокаБазы.СуммаБазы);
			СуммаБазы = СуммаБазы + ВКМ_РасчетЗарплаты.ВКМ_РанееНачисленныеОтпускные(
				Строка.Сотрудник, Запись.БазовыйПериодНачало, Запись.БазовыйПериодКонец, Виды.Отпуск);
			Строка.КоличествоДнейОтпуска = (Строка.ВКМ_ДатаОкончания - Строка.ВКМ_ДатаНачала) / 86400 + 1;
			Строка.ВКМ_СуммаОтпускных = Окр(СуммаБазы / ДанныеДней.РабочихДнейБазы * Строка.КоличествоДнейОтпуска, 2);
			Запись.Сумма = Строка.ВКМ_СуммаОтпускных;
			ДеньОтпуска = Строка.ВКМ_ДатаНачала;
			Пока ДеньОтпуска <= Строка.ВКМ_ДатаОкончания Цикл
				День = Движения.ВКМ_ОстаткиОтпусковСотрудников.Добавить();
				День.ВидДвижения = ВидДвиженияНакопления.Расход;
				День.Период = ДеньОтпуска;
				День.Сотрудник = Строка.Сотрудник;
				День.КоличествоДней = 1;
				ДеньОтпуска = ДеньОтпуска + 86400;
			КонецЦикла;
		КонецЕсли;
		Строка.Итого = Окр(Запись.Сумма, 2);
	КонецЦикла;
	ВКМ_РасчетЗарплаты.ВКМ_РаспределитьНалог(Начисления, "Итого", "НДФЛ", "КВыплате");
	Для Каждого Строка Из Начисления Цикл
		ДоЗаписи = ДополнительныеСвойства.ВКМ_СуммыДоЗаписи[Строка.НомерСтроки - 1];
		Если ДоЗаписи.Итого <> Строка.Итого Или ДоЗаписи.НДФЛ <> Строка.НДФЛ Или ДоЗаписи.КВыплате <> Строка.КВыплате Тогда
			ВызватьИсключение "Расчет платформы отличается от предварительного. Проверьте настройки базы и вытеснения видов расчета";
		КонецЕсли;
		Если Строка.НДФЛ <> 0 Тогда
			Налог = Движения.ВКМ_Удержания.Добавить();
			Налог.ПериодРегистрации = Дата;
			Налог.Сотрудник = Строка.Сотрудник;
			Налог.ВидРасчета = Виды.НДФЛ;
			Налог.Сумма = Строка.НДФЛ;
		КонецЕсли;
		Взаиморасчет = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Взаиморасчет.ВидДвижения = ВидДвиженияНакопления.Приход;
		Взаиморасчет.Период = Дата;
		Взаиморасчет.Сотрудник = Строка.Сотрудник;
		Взаиморасчет.Сумма = Строка.КВыплате;
	КонецЦикла;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		Или (РежимЗаписи = РежимЗаписиДокумента.Запись И Начисления.Количество() > 0) Тогда
		ВКМ_РасчетЗарплаты.ВКМ_ПодготовитьСуммыДоЗаписи(ЭтотОбъект);
		ДополнительныеСвойства.Вставить("ВКМ_СуммыДоЗаписи", Начисления.Выгрузить());
	КонецЕсли;
КонецПроцедуры
