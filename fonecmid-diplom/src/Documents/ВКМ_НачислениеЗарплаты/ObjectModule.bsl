Процедура ОбработкаПроведения(Отказ, Режим)
	Если Не ЗначениеЗаполнено(Период) Тогда
		ВызватьИсключение "Укажите месяц начисления";
	КонецЕсли;
	ВидОклад = ПланыВидовРасчета.ОсновныеНачисления.НайтиПоКоду("ЗП");
	ВидПроцент = ПланыВидовРасчета.ОсновныеНачисления.НайтиПоКоду("ПРОЦ");
	ВидНДФЛ = ПланыВидовРасчета.Удержания.НайтиПоКоду("НЛГ");
	Если Не ЗначениеЗаполнено(ВидОклад) Или Не ЗначениеЗаполнено(ВидПроцент) Или Не ЗначениеЗаполнено(ВидНДФЛ) Тогда
		ВызватьИсключение "Заполните виды расчета с кодами ЗП, ПРОЦ и НЛГ";
	КонецЕсли;
	Если Начисления.Количество() = 0 Тогда
		ВызватьИсключение "Добавьте сотрудников в таблицу начислений";
	КонецЕсли;
	Для Каждого Строка Из Начисления Цикл
		Если Не ЗначениеЗаполнено(Строка.Сотрудник) Тогда
			ВызватьИсключение "Укажите сотрудника в каждой строке начислений";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.ДатаНачала) Тогда
			Строка.ДатаНачала = НачалоМесяца(Период);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Строка.ДатаОкончания) Тогда
			Строка.ДатаОкончания = КонецМесяца(Период);
		КонецЕсли;
		НачПериода = НачалоДня(Строка.ДатаНачала);
		КонПериода = КонецДня(Строка.ДатаОкончания);
		Если КонПериода < НачПериода Или НачалоМесяца(НачПериода) <> НачалоМесяца(Период)
			Или НачалоМесяца(КонПериода) <> НачалоМесяца(Период) Тогда
			ВызватьИсключение "Период строки должен находиться внутри месяца начисления";
		КонецЕсли;
		Если Строка.ВидНачисления <> ВидПроцент И (НачПериода <> НачалоМесяца(Период) Или КонПериода <> КонецМесяца(Период)) Тогда
			ВызватьИсключение "Расчет оклада за неполный месяц требует данных рабочего календаря. Укажите полный месяц";
		КонецЕсли;
		// Пустой вид сохраняет совместимость старых документов: оклад + процент.
		Если ЗначениеЗаполнено(Строка.ВидНачисления) И Строка.ВидНачисления <> ВидОклад И Строка.ВидНачисления <> ВидПроцент Тогда
			ВызватьИсключение "Для выбранного вида начисления отсутствует алгоритм расчета. Поддерживаются ЗП и ПРОЦ";
		КонецЕсли;
		Для Каждого ДругаяСтрока Из Начисления Цикл
			Если ДругаяСтрока.НомерСтроки >= Строка.НомерСтроки Тогда
				Прервать;
			КонецЕсли;
			Если ДругаяСтрока.Сотрудник = Строка.Сотрудник
				И (ДругаяСтрока.ВидНачисления = Строка.ВидНачисления
				Или Не ЗначениеЗаполнено(ДругаяСтрока.ВидНачисления) Или Не ЗначениеЗаполнено(Строка.ВидНачисления)) Тогда
				ВызватьИсключение "Повторное начисление одного вида одному сотруднику в месяце";
			КонецЕсли;
		КонецЦикла;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ Оклад, ПроцентОтРабот
		|ИЗ РегистрСведений.УсловияОплатыСотрудников.СрезПоследних(&Дата, Сотрудник = &Сотрудник)");
		Запрос.УстановитьПараметр("Дата", НачПериода);
		Запрос.УстановитьПараметр("Сотрудник", Строка.Сотрудник);
		Условия = Запрос.Выполнить().Выбрать();
		Если Не Условия.Следующий() Тогда
			ВызватьИсключение СтрШаблон("Не заданы условия оплаты: %1", Строка.Сотрудник);
		КонецЕсли;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ СУММА(ВКМ_СуммаКОплатеОборот) КАК СуммаРабот
		|ИЗ РегистрНакопления.ВКМ_ВыполненныеКлиентуРаботы.Обороты(&Начало, &Конец, , ВКМ_Специалист = &Сотрудник)");
		Запрос.УстановитьПараметр("Начало", НачПериода);
		Запрос.УстановитьПараметр("Конец", КонПериода);
		Запрос.УстановитьПараметр("Сотрудник", Строка.Сотрудник);
		Работы = Запрос.Выполнить().Выбрать();
		Работы.Следующий();
		СуммаРабот = ?(ТипЗнч(Работы.СуммаРабот) = Тип("Null"), 0, Работы.СуммаРабот);
		Строка.Оклад = ?(Строка.ВидНачисления = ВидПроцент, 0, Условия.Оклад);
		Строка.ПроцентОтРабот = ?(Строка.ВидНачисления = ВидОклад, 0, Окр(СуммаРабот * Условия.ПроцентОтРабот / 100, 2));
		Строка.Итого = Строка.Оклад + Строка.ПроцентОтРабот;
		Строка.НДФЛ = Окр(Строка.Итого * 13 / 100, 2);
		Строка.КВыплате = Строка.Итого - Строка.НДФЛ;
	КонецЦикла;
	// --- Очистка движений ---
	Движения.ВзаиморасчетыССотрудниками.Очистить();
	Движения.ОсновныеНачисления.Очистить();
	Движения.Удержания.Очистить();
	Движения.ОстаткиОтпусковСотрудников.Очистить();
	
	Движения.ОсновныеНачисления.Записывать = Истина;
	Движения.Удержания.Записывать = Истина;
	Движения.ВзаиморасчетыССотрудниками.Записывать = Истина;
	Движения.ОстаткиОтпусковСотрудников.Записывать = Истина;
	
	Для Каждого ТекСтрокаНачисления Из Начисления Цикл
		
		Если ТекСтрокаНачисления.Оклад > 0 И ЗначениеЗаполнено(ВидОклад) Тогда
			Движение = Движения.ОсновныеНачисления.Добавить();
			Движение.Сторно = Ложь;
			Движение.ПериодРегистрации = Дата;
			Движение.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			Движение.Сумма = ТекСтрокаНачисления.Оклад;
			Движение.ВидРасчета = ВидОклад;
		КонецЕсли;
		
		Если ТекСтрокаНачисления.ПроцентОтРабот > 0 И ЗначениеЗаполнено(ВидПроцент) Тогда
			Движение = Движения.ОсновныеНачисления.Добавить();
			Движение.Сторно = Ложь;
			Движение.ПериодРегистрации = Дата;
			Движение.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			Движение.Сумма = ТекСтрокаНачисления.ПроцентОтРабот;
			Движение.ВидРасчета = ВидПроцент;
		КонецЕсли;
		
		Если ТекСтрокаНачисления.НДФЛ > 0 И ЗначениеЗаполнено(ВидНДФЛ) Тогда
			Движение = Движения.Удержания.Добавить();
			Движение.Сторно = Ложь;
			Движение.ПериодРегистрации = Дата;
			Движение.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			Движение.Сумма = ТекСтрокаНачисления.НДФЛ;
			Движение.ВидРасчета = ВидНДФЛ;
		КонецЕсли;
		
		Если ТекСтрокаНачисления.КВыплате <> 0 Тогда
			ДвижениеВР = Движения.ВзаиморасчетыССотрудниками.Добавить();
			ДвижениеВР.ВидДвижения = ВидДвиженияНакопления.Приход;
			ДвижениеВР.Период = Дата;
			ДвижениеВР.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			ДвижениеВР.Сумма = ТекСтрокаНачисления.КВыплате;
		КонецЕсли;
		
		// --- Отпуск: только дни ---
		Если ТекСтрокаНачисления.КоличествоДнейОтпуска > 0 Тогда
			
			ДвижениеОтпуск = Движения.ОстаткиОтпусковСотрудников.Добавить();
			ДвижениеОтпуск.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеОтпуск.Период = ТекСтрокаНачисления.ДатаНачала;
			ДвижениеОтпуск.Сотрудник = ТекСтрокаНачисления.Сотрудник;
			ДвижениеОтпуск.КоличествоДней = ТекСтрокаНачисления.КоличествоДнейОтпуска;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
