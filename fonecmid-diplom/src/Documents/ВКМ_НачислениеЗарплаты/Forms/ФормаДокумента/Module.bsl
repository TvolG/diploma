КонецПроцедуры

&НаСервере
Процедура ВКМ_РассчитатьНаСервере()
	Документ = РеквизитФормыВЗначение("Объект");
	// Расчет читает регистры и возвращает строки в форму. Запись/проведение не выполняются.
	НачатьТранзакцию();
	Попытка
		ВКМ_РасчетЗарплаты.ВКМ_ПодготовитьСуммыДоЗаписи(Документ);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ЗначениеВРеквизитФормы(Документ, "Объект");
	Модифицированность = Истина;
КонецПроцедуры

&НаСервере
Процедура ВКМ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = НачалоМесяца(Объект.Дата);
	КонецЕсли;
	Для Каждого Строка Из Объект.Начисления Цикл
		Если ЗначениеЗаполнено(Строка.ВКМ_ДатаРаботНачало)
			И (Строка.ВКМ_ДатаРаботНачало <> Строка.ВКМ_ДатаНачала
			Или Строка.ВКМ_ДатаРаботКонец <> Строка.ВКМ_ДатаОкончания) Тогда
			ВКМ_ОтдельныйПериодРабот = Истина;
		КонецЕсли;
	КонецЦикла;
	ВКМ_НастроитьКолонки(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_НастройкиТаблицыПриИзменении(Элемент)
	ВКМ_НастроитьКолонки(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВКМ_НастроитьКолонки(Форма)
	Форма.Элементы.НачисленияВКМ_ДатаРаботНачало.Видимость = Форма.ВКМ_ОтдельныйПериодРабот;
	Форма.Элементы.НачисленияВКМ_ДатаРаботКонец.Видимость = Форма.ВКМ_ОтдельныйПериодРабот;
	Форма.Элементы.НачисленияОклад.Видимость = Форма.ВКМ_ПодробныйРасчет;
	Форма.Элементы.НачисленияПроцентОтРабот.Видимость = Форма.ВКМ_ПодробныйРасчет;
	Форма.Элементы.НачисленияВКМ_СуммаОтпускных.Видимость = Форма.ВКМ_ПодробныйРасчет;
	Форма.Элементы.НачисленияКоличествоДнейОтпуска.Видимость = Форма.ВКМ_ПодробныйРасчет;
	Форма.Элементы.НачисленияВКМ_НормаДней.Видимость = Форма.ВКМ_ПодробныйРасчет;
	Форма.Элементы.НачисленияВКМ_ФактДней.Видимость = Форма.ВКМ_ПодробныйРасчет;
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_НачисленияПриИзменении(Элемент)
	// Отпуск влияет на другие строки сотрудника; прежние результаты больше не актуальны.
	Для Каждого Строка Из Объект.Начисления Цикл
		Строка.Оклад = 0;
		Строка.ПроцентОтРабот = 0;
		Строка.ВКМ_СуммаОтпускных = 0;
		Строка.Итого = 0;
		Строка.НДФЛ = 0;
		Строка.КВыплате = 0;
		Строка.ВКМ_НормаДней = 0;
		Строка.ВКМ_ФактДней = 0;
		Строка.КоличествоДнейОтпуска = 0;
	КонецЦикла;
КонецПроцедуры
