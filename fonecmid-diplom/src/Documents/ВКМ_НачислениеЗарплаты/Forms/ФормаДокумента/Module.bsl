
&НаСервере
Процедура ВКМ_ЗаполнитьСотрудниковНаСервере()
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = НачалоМесяца(Объект.Дата);
	КонецЕсли;
	Виды = ВКМ_РасчетЗарплаты.ВКМ_ВидыРасчета();
	Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник КАК Сотрудник, Оклад КАК Оклад, ПроцентОтРабот КАК Процент
	|ИЗ РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Месяц)");
	Запрос.УстановитьПараметр("Месяц", НачалоМесяца(Объект.Период));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Оклад > 0 Тогда
			ВКМ_ДобавитьНачисление(Выборка.Сотрудник, Виды.Оклад);
		КонецЕсли;
		Если Выборка.Процент > 0 Тогда
			ВКМ_ДобавитьНачисление(Выборка.Сотрудник, Виды.Процент);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВКМ_ДобавитьНачисление(Сотрудник, Вид)
	Для Каждого Строка Из Объект.Начисления Цикл
		Если Строка.Сотрудник = Сотрудник И Строка.ВКМ_ВидНачисления = Вид Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Строка = Объект.Начисления.Добавить();
	Строка.Сотрудник = Сотрудник;
	Строка.ВКМ_ВидНачисления = Вид;
	Строка.ВКМ_ДатаНачала = НачалоМесяца(Объект.Период);
	Строка.ВКМ_ДатаОкончания = НачалоДня(КонецМесяца(Объект.Период));
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_ЗаполнитьСотрудников(Команда)
	ВКМ_ЗаполнитьСотрудниковНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_ДвиженияВКМ_ОсновныеНачисления(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите документ");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("РегистрРасчета.ВКМ_ОсновныеНачисления.ФормаСписка", Новый Структура("Отбор", Новый Структура("Регистратор", Объект.Ссылка)), ЭтаФорма);
КонецПроцедуры

