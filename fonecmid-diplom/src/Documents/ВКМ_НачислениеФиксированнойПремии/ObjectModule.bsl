Процедура ОбработкаПроведения(Отказ, Режим)
	Виды = ВКМ_РасчетЗарплаты.ВКМ_ВидыРасчета();
	ВКМ_РасчетЗарплаты.ВКМ_ЗаблокироватьСотрудников(СписокСотрудников);
	Если СписокСотрудников.Количество() = 0 Тогда
		ВызватьИсключение "Добавьте сотрудников и суммы премий";
	КонецЕсли;
	Движения.ВКМ_ДополнительныеНачисления.Очистить();
	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Очистить();
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Для Каждого Строка Из СписокСотрудников Цикл
		Если Строка.СуммаПремии < 0 Тогда
			ВызватьИсключение "Сумма премии не может быть отрицательной";
		КонецЕсли;

		Премия = Движения.ВКМ_ДополнительныеНачисления.Добавить();
		Премия.ПериодРегистрации = Дата;
		Премия.ПериодДействияНачало = НачалоМесяца(Дата);
		Премия.ПериодДействияКонец = КонецМесяца(Дата);
		Премия.Сотрудник = Строка.Сотрудник;
		Премия.ВидРасчета = Виды.Премия;
		Премия.Сумма = Строка.СуммаПремии;
		Налог = Движения.ВКМ_Удержания.Добавить();
		Налог.ПериодРегистрации = Дата;
		Налог.Сотрудник = Строка.Сотрудник;
		Налог.ВидРасчета = Виды.НДФЛ;
		Налог.Сумма = Строка.ВКМ_НДФЛ;
		Выплата = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Выплата.Период = Дата;
		Выплата.ВидДвижения = ВидДвиженияНакопления.Приход;
		Выплата.Сотрудник = Строка.Сотрудник;
		Выплата.Сумма = Строка.ВКМ_КВыплате;
	КонецЦикла;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ВКМ_РасчетЗарплаты.ВКМ_РаспределитьНалог(СписокСотрудников, "СуммаПремии", "ВКМ_НДФЛ", "ВКМ_КВыплате");
	КонецЕсли;
КонецПроцедуры
