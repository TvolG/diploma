// ВКМ_Начало: программная доработка формы абонентского договора.
&НаСервере
Процедура ВКМ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Группа = Элементы.Добавить("ВКМ_АбонОбслуживание", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = "Абонентское обслуживание";
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ВКМ_ДобавитьПоле("ВКМ_АбонДатаНачала", "Дата начала", Группа);
	ВКМ_ДобавитьПоле("ВКМ_АбонДатаОкончания", "Дата окончания", Группа);
	ВКМ_ДобавитьПоле("ВКМ_АбонСуммаАбонПлаты", "Абонентская плата", Группа);
	ВКМ_ДобавитьПоле("ВКМ_АбонСтоимостьЧаса", "Стоимость часа", Группа);
	ВКМ_УстановитьВидимость();
КонецПроцедуры

&НаСервере
Процедура ВКМ_ДобавитьПоле(Знач Имя, Знач Заголовок, Родитель)
	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "Объект." + Имя;
	Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура ВКМ_УстановитьВидимость()
	Элементы.ВКМ_АбонОбслуживание.Видимость = Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание;
КонецПроцедуры

&НаКлиенте
Процедура ВКМ_ВидДоговораПриИзменении(Элемент)
	ВКМ_УстановитьВидимость();
КонецПроцедуры
// ВКМ_Конец.
